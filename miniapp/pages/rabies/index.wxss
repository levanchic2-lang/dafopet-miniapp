.card {
  background: #ffffff;
  margin: 24rpx;
  padding: 28rpx;
  border: 1rpx solid #d8d8d4;
  border-radius: 4rpx;
}
.title {
  font-size: 36rpx;
  font-weight: 700;
  color: #171717;
  margin-bottom: 8rpx;
}
.sub {
  font-size: 24rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
.label {
  font-size: 26rpx;
  font-weight: 600;
  color: #171717;
  margin-top: 24rpx;
  margin-bottom: 8rpx;
}
.label:first-child { margin-top: 0; }
.input {
  width: 100%;
  border: 1.5rpx solid #cbc9c3;
  border-radius: 4rpx;
  padding: 22rpx 24rpx;
  font-size: 30rpx;
  color: #171717;
  background: #ffffff;
  box-sizing: border-box;
  min-height: 80rpx;
  line-height: 1.4;
}
.input-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}
.input-row .input { flex: 1; }
.btn {
  width: 100%;
  background: #171717;
  color: #fff;
  border: none;
  border-radius: 4rpx;
  padding: 26rpx 0;
  font-size: 30rpx;
  font-weight: 600;
  margin-top: 32rpx;
}
.btn.secondary {
  background: #f7f7f5;
  color: #171717;
  border: 1rpx solid #cbc9c3;
  font-weight: 500;
}
.btn.sm {
  width: auto;
  padding: 14rpx 28rpx;
  font-size: 26rpx;
  margin-top: 0;
  border-radius: 4rpx;
}
.picker {
  width: 100%;
  border: 1.5rpx solid #cbc9c3;
  border-radius: 4rpx;
  padding: 22rpx 24rpx;
  font-size: 30rpx;
  color: #171717;
  background: #ffffff;
  box-sizing: border-box;
  min-height: 80rpx;
  line-height: 1.4;
}
.row2 {
  display: flex;
  gap: 16rpx;
}
.row2 .col { flex: 1; }
.pet-card {
  border: 2rpx solid #d8d8d4;
  border-radius: 4rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 12rpx;
  font-size: 28rpx;
  color: #333;
  background: #ffffff;
}
.pet-card.selected {
  border-color: #171717;
  background: #f7f7f5;
}
.pet-card-name { font-weight: 600; font-size: 30rpx; }
.pet-card-sub { font-size: 24rpx; color: #666; margin-top: 4rpx; }
.sig-wrap {
  border: 1.5rpx solid #cbc9c3;
  border-radius: 4rpx;
  overflow: hidden;
  background: #ffffff;
  position: relative;
}
.sig-canvas {
  display: block;
  width: 100%;
  height: 260rpx;
}
.sig-hint {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 26rpx;
  color: #777;
  pointer-events: none;
}
.sig-bar {
  display: flex;
  justify-content: flex-end;
  padding: 12rpx 16rpx;
  border-top: 1rpx solid #d8d8d4;
  background: #f7f7f5;
}
.lookup-result {
  background: #edf5f0;
  border: 1rpx solid #b9cec2;
  border-radius: 4rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  color: #1d4d3a;
  margin-top: 12rpx;
}
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 2rpx;
  font-size: 22rpx;
  margin-right: 8rpx;
}
.tag-new { background: #faf4e8; color: #6b4423; }
.tag-found { background: #edf5f0; color: #1d4d3a; }
.divider {
  height: 1rpx;
  background: #d8d8d4;
  margin: 24rpx 0;
}
.duplicate-warning {
  margin-top: 10rpx;
  padding: 16rpx 18rpx;
  border-left: 5rpx solid #7a2828;
  background: #fbf1f1;
  color: #7a2828;
  font-size: 24rpx;
  line-height: 1.55;
}
.addr-scope {
  font-size: 26rpx;
  color: #5f5f5b;
  margin-bottom: 6rpx;
}
.addr-detail {
  width: 100%;
  border: 1.5rpx solid #cbc9c3;
  border-radius: 4rpx;
  padding: 22rpx 24rpx;
  font-size: 30rpx;
  color: #171717;
  background: #ffffff;
  box-sizing: border-box;
  min-height: 80rpx;
  line-height: 1.5;
}
.consent-box {
  border: 1rpx solid #cbc9c3;
  background: #f7f7f5;
  padding: 22rpx 24rpx;
}
.consent-check {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  font-size: 26rpx;
  color: #262626;
  line-height: 1.65;
}
.consent-check checkbox { flex: 0 0 auto; margin-top: 3rpx; }
.consent-toggle {
  margin-top: 18rpx;
  color: #1d4d3a;
  font-size: 25rpx;
  text-decoration: underline;
}
.consent-loading { margin-top: 16rpx; color: #777; font-size: 24rpx; }
.consent-content {
  display: block;
  max-height: 520rpx;
  overflow-y: auto;
  margin-top: 18rpx;
  padding: 20rpx;
  border-top: 1rpx solid #d8d4cc;
  background: #fff;
  font-size: 24rpx;
  color: #333;
  line-height: 1.75;
}
.photo-guide-row,
.photo-upload-row {
  display: flex;
  gap: 16rpx;
}
.photo-guide {
  flex: 1;
  border: 1rpx solid #d8d4cc;
  background: #f7f7f5;
  padding: 10rpx;
  box-sizing: border-box;
  color: #5f5f5b;
  font-size: 21rpx;
  text-align: center;
}
.photo-guide image {
  width: 100%;
  height: 150rpx;
  display: block;
  margin-bottom: 8rpx;
}
.photo-upload-row { margin-top: 18rpx; }
.photo-upload {
  flex: 1;
  min-width: 0;
  border: 1rpx solid #cbc9c3;
  padding: 14rpx;
  box-sizing: border-box;
  background: #fff;
}
.photo-upload-title {
  color: #171717;
  font-size: 25rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}
.photo-selected,
.photo-placeholder {
  width: 100%;
  height: 190rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.photo-selected { background: #f7f7f5; }
.photo-placeholder {
  border: 1rpx dashed #b8b5ae;
  color: #777;
  font-size: 23rpx;
  background: #fafafa;
}
.btn.photo-btn {
  width: 100%;
  margin-top: 12rpx;
  padding: 15rpx 4rpx;
  font-size: 24rpx;
  line-height: 1.3;
}
