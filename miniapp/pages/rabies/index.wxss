.card {
  background: #ffffff;
  margin: 24rpx;
  padding: 28rpx;
  border: 1rpx solid #d8d8d4;
  border-radius: 4rpx;
}
.title {
  font-size: 36rpx;
  font-weight: 700;
  color: #171717;
  margin-bottom: 8rpx;
}
.sub {
  font-size: 24rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
.label {
  font-size: 26rpx;
  font-weight: 600;
  color: #171717;
  margin-top: 24rpx;
  margin-bottom: 8rpx;
}
.label:first-child { margin-top: 0; }
.input {
  width: 100%;
  border: 1.5rpx solid #cbc9c3;
  border-radius: 4rpx;
  padding: 22rpx 24rpx;
  font-size: 30rpx;
  color: #171717;
  background: #ffffff;
  box-sizing: border-box;
  min-height: 80rpx;
  line-height: 1.4;
}
.input-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}
.input-row .input { flex: 1; }
.btn {
  width: 100%;
  background: #171717;
  color: #fff;
  border: none;
  border-radius: 4rpx;
  padding: 26rpx 0;
  font-size: 30rpx;
  font-weight: 600;
  margin-top: 32rpx;
}
.btn.secondary {
  background: #f7f7f5;
  color: #171717;
  border: 1rpx solid #cbc9c3;
  font-weight: 500;
}
.btn.sm {
  width: auto;
  padding: 14rpx 28rpx;
  font-size: 26rpx;
  margin-top: 0;
  border-radius: 4rpx;
}
.picker {
  width: 100%;
  border: 1.5rpx solid #cbc9c3;
  border-radius: 4rpx;
  padding: 22rpx 24rpx;
  font-size: 30rpx;
  color: #171717;
  background: #ffffff;
  box-sizing: border-box;
  min-height: 80rpx;
  line-height: 1.4;
}
.row2 {
  display: flex;
  gap: 16rpx;
}
.row2 .col { flex: 1; }
.pet-card {
  border: 2rpx solid #d8d8d4;
  border-radius: 4rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 12rpx;
  font-size: 28rpx;
  color: #333;
  background: #ffffff;
}
.pet-card.selected {
  border-color: #171717;
  background: #f7f7f5;
}
.pet-card-name { font-weight: 600; font-size: 30rpx; }
.pet-card-sub { font-size: 24rpx; color: #666; margin-top: 4rpx; }
.sig-wrap {
  border: 1.5rpx solid #cbc9c3;
  border-radius: 4rpx;
  overflow: hidden;
  background: #ffffff;
  position: relative;
}
.sig-canvas {
  display: block;
  width: 100%;
  height: 260rpx;
}
.sig-hint {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 26rpx;
  color: #777;
  pointer-events: none;
}
.sig-bar {
  display: flex;
  justify-content: flex-end;
  padding: 12rpx 16rpx;
  border-top: 1rpx solid #d8d8d4;
  background: #f7f7f5;
}
.lookup-result {
  background: #edf5f0;
  border: 1rpx solid #b9cec2;
  border-radius: 4rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  color: #1d4d3a;
  margin-top: 12rpx;
}
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 2rpx;
  font-size: 22rpx;
  margin-right: 8rpx;
}
.tag-new { background: #faf4e8; color: #6b4423; }
.tag-found { background: #edf5f0; color: #1d4d3a; }
.divider {
  height: 1rpx;
  background: #d8d8d4;
  margin: 24rpx 0;
}
.addr-scope {
  font-size: 26rpx;
  color: #5f5f5b;
  margin-bottom: 6rpx;
}
.addr-detail {
  width: 100%;
  border: 1.5rpx solid #cbc9c3;
  border-radius: 4rpx;
  padding: 22rpx 24rpx;
  font-size: 30rpx;
  color: #171717;
  background: #ffffff;
  box-sizing: border-box;
  min-height: 80rpx;
  line-height: 1.5;
}
