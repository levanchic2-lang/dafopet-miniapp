.page { background: #f7f7f5; min-height: 100vh; padding-bottom: 160rpx; }
.swiper { width: 100%; height: 480rpx; }
.swiper-img { width: 100%; height: 480rpx; display: block; object-fit: cover; }
.swiper-placeholder {
  width: 100%; height: 300rpx; background: #f1f1ee;
  display: flex; align-items: center; justify-content: center; font-size: 100rpx;
}
.card { background: #fff; margin: 20rpx 24rpx; border: 1rpx solid #d8d8d4; border-radius: 4rpx; padding: 28rpx; }
.name { font-size: 40rpx; font-weight: 700; color: #171717; margin-bottom: 10rpx; }
.meta { font-size: 26rpx; color: #666; margin-bottom: 20rpx; }
.section-title { font-size: 26rpx; font-weight: 700; color: #171717; margin-bottom: 10rpx; margin-top: 20rpx; }
.section-title:first-child { margin-top: 0; }
.section-text { font-size: 28rpx; color: #333; line-height: 1.7; }
.video { width: 100%; border-radius: 4rpx; margin-top: 12rpx; }
.bottom-bar {
  position: fixed; bottom: 0; left: 0; right: 0;
  background: #fff; padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #cbc9c3;
  display: flex; gap: 16rpx;
}
.contact-btn {
  border: none; border-radius: 4rpx; padding: 28rpx 0;
  font-size: 30rpx; font-weight: 700; flex: 1; text-align: center;
}
.phone-btn { background: #171717; color: #fff; }
.cs-btn { background: #1d4d3a; color: #fff; }
