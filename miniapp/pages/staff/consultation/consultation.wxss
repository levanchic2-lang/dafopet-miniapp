@import "../../../staff.wxss";
.consultation-page{padding-bottom:70rpx}.consultation-hero{margin:0 -28rpx 24rpx;padding:32rpx;background:#171717;color:#fff}.consultation-pet{margin-top:9rpx;font-size:46rpx;font-weight:750}.consultation-sub{margin-top:10rpx;color:#bdbdb9;font-size:21rpx}.consultation-warning{margin-bottom:18rpx;padding:17rpx 18rpx;border-left:5rpx solid #8a4b24;background:#f7eee7;color:#6b4423;font-size:21rpx;line-height:1.55}.start-panel,.recording-panel,.processing-panel,.failed-panel{padding:28rpx 24rpx;background:#fff;border:1rpx solid #d8d8d4;text-align:center}.start-title,.processing-title,.failed-title{font-size:28rpx;font-weight:700}.start-sub,.processing-sub,.failed-message{margin-top:12rpx;color:#686864;font-size:21rpx;line-height:1.65}.start-button,.stop-button,.confirm-button{height:88rpx;margin:24rpx 0 0;border:0;border-radius:0;background:#171717;color:#fff;font-size:24rpx;font-weight:700;line-height:88rpx}.start-button::after,.stop-button::after,.confirm-button::after,.failed-actions button::after{border:0}.start-button[disabled]{background:#b6b6b1;color:#eee}.recording-panel{border-left:5rpx solid #7c302c}.recording-dot{width:22rpx;height:22rpx;margin:0 auto;background:#9a302c;border-radius:50%;animation:pulse 1.2s infinite}.recording-label{margin-top:16rpx;color:#7c302c;font-size:23rpx;font-weight:700}.recording-time{margin-top:10rpx;font-size:66rpx;font-variant-numeric:tabular-nums}.recording-tip{color:#777;font-size:19rpx}.stop-button{background:#7c302c}.processing-panel{border-left:5rpx solid #1d4d3a}.failed-panel{border-left:5rpx solid #7c302c}.failed-title,.failed-message{color:#7c302c}.failed-actions{display:grid;grid-template-columns:1fr 1fr;gap:12rpx;margin-top:22rpx}.failed-actions button{height:76rpx;margin:0;border-radius:0;background:#171717;color:#fff;font-size:21rpx;line-height:76rpx}.failed-actions button:last-child{background:#fff;color:#171717;border:1rpx solid #171717}.consultation-section{margin:30rpx 0 12rpx;display:flex;justify-content:space-between;color:#66625d;font-size:20rpx;letter-spacing:2rpx}.draft-form{background:#fff;border:1rpx solid #d8d8d4}.draft-field{padding:21rpx;border-bottom:1rpx solid #dedbd4}.draft-field:last-child{border-bottom:0}.draft-label{margin-bottom:10rpx;color:#1d4d3a;font-size:20rpx;font-weight:700;letter-spacing:2rpx}.draft-field textarea{width:100%;min-height:118rpx;color:#20201f;font-size:23rpx;line-height:1.65;box-sizing:border-box}.transcript-toggle{margin-top:18rpx;padding:20rpx;display:flex;justify-content:space-between;background:#f0eee9;border:1rpx solid #d8d4cc;color:#4b4b48;font-size:21rpx}.transcript-text{padding:20rpx;background:#fff;border:1rpx solid #d8d4cc;border-top:0;color:#55524d;font-size:21rpx;line-height:1.7;white-space:pre-wrap}.confirm-button{width:100%;margin-top:20rpx}.confirmed-note{margin-top:18rpx;padding:18rpx;border-left:5rpx solid #1d4d3a;background:#edf4f0;color:#355849;font-size:20rpx;line-height:1.6}@keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.35;transform:scale(.75)}}
