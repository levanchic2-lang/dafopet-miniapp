@import "../../../staff.wxss";
.calendar-page{padding-left:20rpx;padding-right:20rpx}.calendar-head{display:flex;align-items:flex-end;justify-content:space-between;padding:20rpx 8rpx 24rpx}.calendar-title{margin-top:7rpx;font-size:48rpx;font-weight:750}.calendar-nav{display:flex;gap:8rpx}.calendar-nav button{margin:0;width:64rpx;height:60rpx;padding:0;border-radius:0;background:#fff;border:1rpx solid #cfcfca;font-size:30rpx;line-height:58rpx}.calendar-nav button::after{border:0}.timeline-shell{background:#fff;border:1rpx solid #d7d7d2}.timeline-days{height:96rpx;display:grid;grid-template-columns:74rpx repeat(3,1fr);border-bottom:1rpx solid #cfcfca}.day-head{display:flex;flex-direction:column;align-items:center;justify-content:center;border-left:1rpx solid #e0e0dc;color:#777;font-size:20rpx}.day-head strong{margin-top:5rpx;color:#171717;font-size:25rpx}.day-head.today{background:#171717;color:#bdbdbd}.day-head.today strong{color:#fff}.timeline-scroll{height:calc(100vh - 360rpx)}.timeline-body{height:1170rpx;display:grid;grid-template-columns:74rpx repeat(3,1fr);position:relative}.time-axis{background:#fafafa}.hour-label{height:78rpx;padding:7rpx 8rpx 0 0;text-align:right;box-sizing:border-box;color:#9a9a95;font-size:18rpx}.day-column{position:relative;border-left:1rpx solid #e2e2dd}.hour-line{height:78rpx;border-bottom:1rpx solid #ecece8;box-sizing:border-box}.calendar-event{position:absolute;left:5rpx;right:5rpx;z-index:2;min-height:58rpx;padding:7rpx 8rpx;overflow:hidden;box-sizing:border-box;border-left:5rpx solid #666;background:#efefec}.calendar-event.blue{background:#e7f0f3;border-color:#426a78}.calendar-event.green{background:#e7f1eb;border-color:#1d6045}.calendar-event.red{background:#f4e7e5;border-color:#8a332e}.calendar-event.pink{background:#f3e9ee;border-color:#87506b}.calendar-event.amber{background:#f3ede0;border-color:#8a632b}.event-time{font-size:17rpx;color:#666}.event-title{font-size:21rpx;font-weight:750;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.event-service{font-size:17rpx;color:#666;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.sheet-mask{position:fixed;z-index:50;inset:0;background:rgba(0,0,0,.45);display:flex;align-items:flex-end}.detail-sheet{width:100%;max-height:82vh;padding:16rpx 30rpx calc(30rpx + env(safe-area-inset-bottom));overflow-y:auto;background:#fff;box-sizing:border-box}.sheet-grip{width:72rpx;height:6rpx;margin:0 auto 24rpx;background:#bbb}.detail-eyebrow{color:#1d4d3a;font-size:19rpx;letter-spacing:3rpx}.detail-title{margin:10rpx 0 24rpx;font-size:36rpx;font-weight:750}.detail-row{padding:18rpx 0;display:grid;grid-template-columns:100rpx 1fr;border-top:1rpx solid #e1e1dc;font-size:23rpx}.detail-row text:first-child{color:#858580}.detail-primary{margin:24rpx 0 16rpx;height:82rpx;border:0;border-radius:0;background:#171717;color:#fff;font-size:24rpx;font-weight:700}.detail-primary::after,.detail-actions button::after{border:0}.detail-actions{display:grid;grid-template-columns:repeat(3,1fr);gap:10rpx}.detail-actions button{margin:0;padding:0;height:72rpx;border-radius:0;background:#fff;border:1rpx solid #cfcfca;font-size:21rpx}.detail-actions button.danger{color:#7c302c;border-color:#a86b67}.form-line{height:82rpx;padding:0 18rpx;display:flex;align-items:center;justify-content:space-between;border:1rpx solid #d5d5d0;border-bottom:0;font-size:23rpx}.form-line text,.form-field>text{color:#737373}.form-field{padding:16rpx 18rpx;border:1rpx solid #d5d5d0;border-bottom:0;font-size:22rpx}.form-field:last-of-type{border-bottom:1rpx solid #d5d5d0}.form-field input,.form-field textarea{width:100%;margin-top:10rpx;font-size:25rpx;line-height:1.5}
