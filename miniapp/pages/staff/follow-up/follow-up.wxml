<view class="staff-page follow-detail-page">
  <view wx:if="{{loading}}" class="staff-loading">正在读取随访任务…</view>
  <view wx:if="{{error}}" class="staff-error">{{error}}</view>
  <block wx:if="{{!loading && item.id}}">
    <view class="follow-hero"><view class="staff-eyebrow">{{item.kind_label}} · #{{item.id}}</view><view class="follow-pet">{{item.pet.name}}</view><view class="follow-sub">{{item.customer.name}} · {{item.planned_date}} · {{item.status_label}}</view><view class="follow-title">{{item.title}}</view></view>
    <view class="follow-info"><view wx:if="{{item.visit.id}}"><text>关联病例</text><text>#{{item.visit.id}} · {{item.visit.status === 'closed' ? '已结束' : '进行中'}}</text></view><view wx:if="{{item.visit.id}}"><text>诊断</text><text>{{item.visit.diagnosis || '未填写'}}</text></view><view wx:else><text>任务分类</text><text>{{item.category_label}}</text></view><view><text>负责人</text><picker mode="selector" range="{{assignees}}" range-key="label" value="{{assigneeIndex < 0 ? 0 : assigneeIndex}}" bindchange="onAssignee"><text>{{assigneeIndex >= 0 ? assignees[assigneeIndex].label : '待认领，点击分配'}}</text></picker></view><view wx:if="{{item.reason}}"><text>安排原因</text><text>{{item.reason}}</text></view><view wx:if="{{item.question}}"><text>本次询问</text><text>{{item.question}}</text></view><view wx:if="{{item.risk_trigger}}" class="risk"><text>升级条件</text><text>{{item.risk_trigger}}</text></view></view>
    <button wx:if="{{item.customer.phone}}" class="call-button" bindtap="callCustomer">拨打 {{item.customer.phone_masked}}</button>
    <view wx:if="{{item.customer_response_note}}" class="customer-response"><view>客户已有反馈</view><text>{{item.customer_response_note}}</text></view>

    <view wx:if="{{item.status !== 'closed' && item.status !== 'skipped'}}">
      <view wx:if="{{questionRows.length}}" class="structured-block">
        <view class="structured-head"><view>模板随访内容</view><text>{{item.template_name}} · {{questionRows.length}} 项</text></view>
        <view wx:for="{{questionRows}}" wx:key="key" wx:for-item="q" wx:for-index="qIndex" class="question-card">
          <view class="question-label"><text>{{qIndex + 1}}</text><view>{{q.label}}<text wx:if="{{q.help}}" class="question-help">{{q.help}}</text></view></view>
          <view wx:if="{{q.type === 'scale1to5'}}" class="scale-row">
            <view wx:for="{{q.scale_choices}}" wx:key="value" wx:for-item="choice" class="scale-choice {{choice.selected ? 'active' : ''}}" data-index="{{qIndex}}" data-value="{{choice.value}}" bindtap="chooseScale">{{choice.value}}</view>
          </view>
          <view wx:elif="{{q.type === 'select' || q.type === 'upload'}}" class="question-options">
            <view wx:for="{{q.choice_options}}" wx:key="label" wx:for-item="choice" class="option-choice {{choice.selected ? 'active' : ''}}" data-index="{{qIndex}}" data-value="{{choice.label}}" bindtap="chooseQuestionOption">{{choice.label}}</view>
          </view>
          <view wx:elif="{{q.type === 'multi'}}" class="question-options">
            <view wx:for="{{q.choice_options}}" wx:key="label" wx:for-item="choice" class="option-choice {{choice.selected ? 'active' : ''}}" data-index="{{qIndex}}" data-value="{{choice.label}}" bindtap="toggleMulti">{{choice.label}}</view>
          </view>
          <input wx:elif="{{q.type === 'number'}}" class="question-input" type="digit" value="{{q.value}}" data-index="{{qIndex}}" bindinput="onQuestionInput" placeholder="请输入数值" />
          <textarea wx:else class="question-input question-text" value="{{q.value}}" data-index="{{qIndex}}" bindinput="onQuestionInput" placeholder="请输入记录" maxlength="500" />
        </view>
      </view>

      <view wx:if="{{recommendation.message}}" class="recommendation {{recommendation.level}}">
        <view>{{recommendation.level === 'urgent' ? '需要立即关注' : recommendation.level === 'warning' ? '建议进一步处理' : recommendation.level === 'good' ? '目前情况稳定' : '继续观察'}}</view>
        <text>{{recommendation.message}}</text>
        <text wx:if="{{recommendation.signals_text}}" class="signals">依据：{{recommendation.signals_text}}</text>
      </view>

      <view class="form-label">本次随访结果</view>
      <view class="choice-grid outcome-grid"><view wx:for="{{outcomes}}" wx:key="value" class="choice {{outcome === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="chooseOutcome">{{item.label}}</view></view>
      <view class="form-label">下一步</view>
      <view class="choice-grid action-grid"><view wx:for="{{actions}}" wx:key="value" class="choice {{nextAction === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="chooseAction">{{item.label}}</view></view>

      <view wx:if="{{nextAction === 'reschedule'}}" class="conditional"><text>再次联系日期</text><picker mode="date" value="{{nextDate}}" bindchange="onNextDate"><view class="picker-value">{{nextDate || '请选择日期'}}</view></picker></view>
      <view wx:if="{{nextAction === 'appointment'}}" class="conditional"><text>复诊预约</text><view class="date-time"><picker mode="date" value="{{appointmentDate}}" bindchange="onAppointmentDate"><view class="picker-value">{{appointmentDate}}</view></picker><picker mode="time" value="{{appointmentTime}}" bindchange="onAppointmentTime"><view class="picker-value">{{appointmentTime}}</view></picker></view></view>
      <view class="form-label">处理备注</view><textarea class="follow-textarea" value="{{note}}" bindinput="onNote" placeholder="补充客户描述、沟通情况或医生需要关注的内容" maxlength="1000" />

      <view wx:if="{{outcome === 'recovered' && item.visit.id && item.visit.status !== 'closed'}}" class="close-box">
        <view class="close-switch"><view><strong>同时结束病历</strong><text>恢复良好时，系统建议检查是否可以结束病历</text></view><switch checked="{{closeVisit}}" color="#1d4d3a" bindchange="onCloseVisit" /></view>
        <view wx:if="{{closeVisit}}" class="close-warning">病历结束后不可修改，操作人将记录为当前小程序账号。已安排的后续随访不会受到影响。</view>
      </view>
      <button class="submit-button" loading="{{busy}}" disabled="{{busy}}" bindtap="submit">确认记录本次随访</button>
    </view>
    <view wx:else class="done-box"><view>{{item.staff_outcome_label || '随访已完成'}}</view><text>{{item.next_action_label}}</text><view wx:if="{{item.staff_answer_items.length}}" class="done-answers"><text wx:for="{{item.staff_answer_items}}" wx:key="key">{{item.label}}：{{item.value}}</text></view><text wx:if="{{item.handle_note}}">{{item.handle_note}}</text><text wx:if="{{item.handled_by}}">{{item.handled_by}} · {{item.handled_at}}</text></view>
  </block>
</view>
