<view class="staff-page new-follow-page">
  <view wx:if="{{loading}}" class="staff-loading">正在读取病例…</view><view wx:if="{{error}}" class="staff-error">{{error}}</view>
  <block wx:if="{{!loading && visit.id}}">
    <view class="new-hero"><view class="staff-eyebrow">CASE · #{{visit.id}}</view><view class="new-pet">{{pet.name}}</view><view class="new-sub">{{customer.name}} · {{visit.date}} · {{visit.status === 'closed' ? '病历已结束' : '病历进行中'}}</view><view class="new-diagnosis">{{visit.diagnosis || '未填写诊断'}}</view></view>
    <view class="form-label">随访模板与轮次</view>
    <picker mode="selector" range="{{templates}}" range-key="label" value="{{templateIndex < 0 ? 0 : templateIndex}}" bindchange="onTemplate"><view class="input-like">{{templateIndex >= 0 ? selectedTemplate.label : '请选择本次要问的模板'}}</view></picker>
    <view wx:if="{{templateIndex >= 0}}" class="template-summary">{{selectedTemplate.question_count}} 项结构化内容 · 建议 D+{{selectedTemplate.day_offset}} 天 · {{selectedTemplate.kind === 'surgery' ? '手术随访' : selectedTemplate.kind === 'discharge' ? '出院随访' : selectedTemplate.kind === 'chronic' ? '慢病复查' : '病例回访'}}</view>
    <view class="form-label">随访日期</view><picker mode="date" value="{{plannedDate}}" bindchange="onDate"><view class="input-like">{{plannedDate}}</view></picker>
    <view class="form-label">负责人</view><picker mode="selector" range="{{assignees}}" range-key="label" value="{{assigneeIndex < 0 ? 0 : assigneeIndex}}" bindchange="onAssignee"><view class="input-like">{{assigneeIndex >= 0 ? assignees[assigneeIndex].label + ' · ' + assignees[assigneeIndex].role : '请选择负责随访的员工'}}</view></picker>
    <view class="form-label">特别关注</view><textarea class="text-area short" value="{{question}}" bindinput="onQuestion" placeholder="选填，例如：重点确认昨晚是否再次呕吐" maxlength="1000" />
    <view class="form-label">安排原因 / 特别说明</view><textarea class="text-area short" value="{{reason}}" bindinput="onReason" placeholder="选填" maxlength="1000" />
    <view class="form-label">优先级</view><view class="priority-row"><view class="{{priority === 'normal' ? 'active' : ''}}" data-value="normal" bindtap="choosePriority">普通</view><view class="{{priority === 'high' ? 'active' : ''}}" data-value="high" bindtap="choosePriority">重点</view><view class="{{priority === 'urgent' ? 'active' : ''}}" data-value="urgent" bindtap="choosePriority">紧急</view></view>
    <button class="submit-button" loading="{{busy}}" disabled="{{busy}}" bindtap="submit">确认安排随访</button>
  </block>
</view>
