@import "../../../staff.wxss";
.follow-list-page{padding-bottom:50rpx}.follow-tabs{height:76rpx;margin:0 0 22rpx;display:grid;grid-template-columns:repeat(3,1fr);background:#e9e9e5}.follow-tabs view{display:flex;align-items:center;justify-content:center;color:#737373;font-size:23rpx}.follow-tabs .active{background:#171717;color:#fff;font-weight:700}.follow-warning{margin-bottom:18rpx;padding:18rpx 20rpx;border-left:6rpx solid #7c302c;background:#f7eeee;color:#7c302c;font-size:22rpx}.follow-card{margin-bottom:14rpx;padding:22rpx;background:#fff;border:1rpx solid #d8d8d4}.follow-card-head,.follow-card-foot{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.follow-kind{padding:5rpx 9rpx;background:#eef5f1;color:#1d4d3a;font-size:19rpx}.follow-date{margin-left:12rpx;color:#737373;font-size:21rpx}.follow-date.late{color:#7c302c;font-weight:700}.follow-status{color:#6b4423;font-size:20rpx}.follow-name{margin-top:16rpx;font-size:31rpx;font-weight:750}.follow-title{margin-top:8rpx;color:#3f3f3c;font-size:24rpx;font-weight:650}.follow-diagnosis,.follow-question{margin-top:9rpx;color:#737373;font-size:21rpx;line-height:1.55}.follow-question{padding:12rpx 14rpx;background:#f3f3f0}.follow-result{margin-top:12rpx;color:#1d4d3a;font-size:21rpx}.follow-owner{margin-top:12rpx;color:#525252;font-size:20rpx}.follow-card-foot{margin-top:18rpx;padding-top:15rpx;border-top:1rpx solid #e1e1dc;color:#858580;font-size:20rpx}.follow-card-foot button{height:54rpx;margin:0;padding:0 16rpx;border:1rpx solid #171717;border-radius:0;background:#fff;color:#171717;font-size:20rpx;line-height:52rpx}.follow-card-foot button::after{border:0}.follow-filters{display:flex;justify-content:space-between;gap:16rpx;margin:-4rpx 0 18rpx}.filter-group{display:flex;border:1rpx solid #d8d8d4;background:#fff}.filter-group view{padding:12rpx 18rpx;color:#737373;font-size:20rpx}.filter-group .active{background:#171717;color:#fff}.follow-unassigned{margin-bottom:16rpx;padding:15rpx 18rpx;border-left:5rpx solid #6b4423;background:#f7f2ec;color:#6b4423;font-size:21rpx}
