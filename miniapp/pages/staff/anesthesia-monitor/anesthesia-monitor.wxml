<view class="staff-page monitor-page">
  <view wx:if="{{loading}}" class="staff-loading">正在读取监护记录…</view><view wx:if="{{error}}" class="staff-error">{{error}}</view>
  <block wx:if="{{!loading && sheet.id}}">
    <view class="monitor-hero"><view><view class="staff-eyebrow">AM{{sheet.id}} · {{sheet.monitor_date}}</view><view class="monitor-pet">{{sheet.pet.name}}</view><view class="monitor-meta">{{sheet.customer.name}} · {{sheet.procedure || '术式待填写'}} · {{sheet.start_time}}</view></view><view class="monitor-status {{sheet.status}}">{{sheet.status === 'open' ? '监护中' : '已结束'}}</view></view>
    <view wx:if="{{reminderText}}" class="monitor-reminder {{reminderLate ? 'late' : ''}}"><text>{{reminderText}}</text><text>{{sheet.entries.length}} 次记录</text></view>
    <view class="monitor-tabs"><view class="{{tab === 'monitor' ? 'active' : ''}}" data-tab="monitor" bindtap="setTab">监护记录</view><view class="{{tab === 'medication' ? 'active' : ''}}" data-tab="medication" bindtap="setTab">实际用药</view><view class="{{tab === 'recovery' ? 'active' : ''}}" data-tab="recovery" bindtap="setTab">结束与复苏</view></view>

    <block wx:if="{{tab === 'monitor'}}">
      <view class="fold-head" bindtap="toggleSetup"><text>麻醉基本信息</text><text>{{showSetup ? '−' : '+'}}</text></view>
      <view wx:if="{{showSetup}}" class="form-panel">
        <label>术式<input data-field="procedure" value="{{header.procedure}}" bindinput="headerField"/></label><view class="form-grid"><label>麻醉/监护人<input data-field="anesthetist" value="{{header.anesthetist}}" bindinput="headerField"/></label><label>术者<input data-field="surgeon" value="{{header.surgeon}}" bindinput="headerField"/></label><label>ASA 分级<input data-field="asa_grade" value="{{header.asa_grade}}" bindinput="headerField" placeholder="I~V"/></label><label>体重 kg<input type="digit" data-field="weight_kg" value="{{header.weight_kg}}" bindinput="headerField"/></label><label>主麻醉药<input data-field="agent" value="{{header.agent}}" bindinput="headerField"/></label><label>开始时间<input data-field="start_time" value="{{header.start_time}}" bindinput="headerField" placeholder="HH:MM"/></label></view><label>总体备注<textarea data-field="notes" value="{{header.notes}}" bindinput="headerField"/></label><button class="primary-btn" bindtap="saveHeader" loading="{{busy}}">保存基本信息</button>
      </view>
      <view wx:if="{{sheet.status === 'open'}}" class="vital-panel"><view class="panel-title">记录当前体征</view><view class="form-grid vital-grid"><label>心率 HR<input type="number" data-field="hr" value="{{vital.hr}}" bindinput="vitalField" placeholder="bpm"/></label><label>呼吸 RR<input type="number" data-field="rr" value="{{vital.rr}}" bindinput="vitalField" placeholder="/min"/></label><label>血氧 SpO₂<input type="number" data-field="spo2" value="{{vital.spo2}}" bindinput="vitalField" placeholder="%"/></label><label>EtCO₂<input type="number" data-field="etco2" value="{{vital.etco2}}" bindinput="vitalField" placeholder="mmHg"/></label><label>体温 ℃<input type="digit" data-field="temperature_c" value="{{vital.temperature_c}}" bindinput="vitalField"/></label><label>麻醉浓度 %<input type="digit" data-field="agent_pct" value="{{vital.agent_pct}}" bindinput="vitalField"/></label><label>收缩压<input type="number" data-field="bp_sys" value="{{vital.bp_sys}}" bindinput="vitalField"/></label><label>舒张压<input type="number" data-field="bp_dia" value="{{vital.bp_dia}}" bindinput="vitalField"/></label><label>平均压 MAP<input type="number" data-field="bp_map" value="{{vital.bp_map}}" bindinput="vitalField"/></label><label>氧流量 L/min<input type="digit" data-field="o2_flow" value="{{vital.o2_flow}}" bindinput="vitalField"/></label></view><view class="field-label">麻醉深度</view><view class="choice-row"><view class="{{vital.depth === 'light' ? 'active' : ''}}" data-value="light" bindtap="setDepth">偏浅</view><view class="{{vital.depth === 'adequate' ? 'active' : ''}}" data-value="adequate" bindtap="setDepth">适宜</view><view class="{{vital.depth === 'deep' ? 'active' : ''}}" data-value="deep" bindtap="setDepth">偏深</view></view><label class="wide-label">事件 / 备注<input data-field="event" value="{{vital.event}}" bindinput="vitalField" placeholder="如体动、调整麻醉浓度、拔管"/></label><label class="wide-label">补录时间（可选）<input data-field="time_hhmm" value="{{vital.time_hhmm}}" bindinput="vitalField" placeholder="默认当前时间"/></label><button class="record-btn" bindtap="recordVital" loading="{{busy}}">记录当前 · 下次 5 分钟后</button></view>
      <view class="staff-section-head history-head"><text>监护时间轴</text><text class="staff-section-meta">{{sheet.entries.length}} 条</text></view><view wx:if="{{!sheet.entries.length}}" class="staff-empty">尚无体征记录。</view><view wx:for="{{sheet.entries}}" wx:key="id" class="timeline-row"><view class="timeline-time">{{item.time}}</view><view class="timeline-main"><view class="timeline-values"><text wx:if="{{item.hr}}" class="{{item.flags.hr}}">HR {{item.hr}}</text><text wx:if="{{item.rr}}" class="{{item.flags.rr}}">RR {{item.rr}}</text><text wx:if="{{item.spo2}}" class="{{item.flags.spo2}}">SpO₂ {{item.spo2}}</text><text wx:if="{{item.etco2}}">EtCO₂ {{item.etco2}}</text><text wx:if="{{item.temperature_c}}" class="{{item.flags.temp}}">T {{item.temperature_c}}</text><text wx:if="{{item.bp_sys || item.bp_dia}}">BP {{item.bp_sys}}/{{item.bp_dia}}({{item.bp_map}})</text></view><view wx:if="{{item.depth_label || item.event}}" class="timeline-event">{{item.depth_label}}{{item.depth_label && item.event ? ' · ' : ''}}{{item.event}}</view></view></view>
    </block>

    <block wx:if="{{tab === 'medication'}}">
      <view class="med-notice">临床剂量用于医疗记录；实际出库量按库存单位扣减。例：临床剂量填 5μg，实际出库按药品浓度换算后填 ml。</view>
      <view wx:if="{{sheet.status === 'open'}}" class="fold-head" bindtap="toggleOpenVial"><text>登记开瓶</text><text>{{showOpenVial ? '−' : '+'}}</text></view><view wx:if="{{showOpenVial && sheet.status === 'open'}}" class="form-panel"><label>药品<picker range="{{sheet.inventory}}" range-key="name" value="{{inventoryIndex}}" bindchange="selectInventory"><view class="picker-box">{{vial.item_id ? sheet.inventory[inventoryIndex].name + ' · 库存 ' + sheet.inventory[inventoryIndex].stock_qty + sheet.inventory[inventoryIndex].unit : '请选择麻醉/管控药品'}}</view></picker></label><label wx:if="{{currentBatches.length}}">批号<picker range="{{currentBatches}}" range-key="batch_no" value="{{batchIndex}}" bindchange="selectBatch"><view class="picker-box">{{currentBatches[batchIndex].batch_no}} · {{currentBatches[batchIndex].expiry_date}}</view></picker></label><label>本次开瓶量<input type="digit" data-field="opened_qty" value="{{vial.opened_qty}}" bindinput="vialField"/></label><label>备注<input data-field="notes" value="{{vial.notes}}" bindinput="vialField"/></label><button class="primary-btn" bindtap="openVial" loading="{{busy}}">确认开瓶</button></view>
      <view wx:if="{{sheet.status === 'open' && sheet.open_vials.length}}" class="med-panel"><view class="panel-title">记录实际给药</view><label>使用开瓶记录<picker range="{{sheet.open_vials}}" range-key="drug_name" value="{{vialIndex}}" bindchange="selectVial"><view class="picker-box">{{sheet.open_vials[vialIndex].drug_name}} · 余 {{sheet.open_vials[vialIndex].remaining}}{{sheet.open_vials[vialIndex].unit}}</view></picker></label><view class="field-label">给药阶段</view><view class="phase-grid"><view wx:for="{{sheet.phases}}" wx:key="key" class="{{medication.phase === item.key ? 'active' : ''}}" data-value="{{item.key}}" bindtap="setPhase">{{item.label}}</view></view><view class="form-grid"><label>临床剂量<input data-field="dose_text" value="{{medication.dose_text}}" bindinput="medField" placeholder="如 5μg"/></label><label>实际出库量<input type="digit" data-field="qty" value="{{medication.qty}}" bindinput="medField" placeholder="按库存单位"/></label><label>给药途径<input data-field="route" value="{{medication.route}}" bindinput="medField" placeholder="IV / IM"/></label><label>给药时间<input data-field="time_hhmm" value="{{medication.time_hhmm}}" bindinput="medField"/></label></view><label>备注<input data-field="note" value="{{medication.note}}" bindinput="medField" placeholder="首次诱导 / 追加镇痛"/></label><button class="record-btn" bindtap="recordMedication" loading="{{busy}}">记录给药并扣库存</button></view><view wx:elif="{{sheet.status === 'open'}}" class="staff-empty">请先登记当天开瓶，再记录实际给药。</view>
      <view class="staff-section-head history-head"><text>用药记录</text><text class="staff-section-meta">{{sheet.medications.length}} 条</text></view><view wx:if="{{!sheet.medications.length}}" class="staff-empty">尚无实际给药。</view><view wx:for="{{sheet.medications}}" wx:key="id" class="med-row"><view class="med-time">{{item.time}}</view><view class="med-main"><view class="med-name">{{item.drug_name}} · {{item.phase_label}}</view><view class="med-sub">{{item.dose_text || '未填临床剂量'}} · 出库 {{item.qty}}{{item.unit}} · {{item.route || '未填途径'}}</view><view wx:if="{{item.note}}" class="med-sub">{{item.note}}</view></view><view class="review {{item.review_status}}">{{item.review_status === 'reviewed' ? '已复核' : (item.review_status === 'voided' ? '已更正' : '待复核')}}</view></view>
    </block>

    <block wx:if="{{tab === 'recovery'}}">
      <view wx:if="{{sheet.status === 'open'}}" class="recovery-panel"><view class="panel-title">结束监护与复苏</view><view class="form-grid"><label>麻醉结束<input data-field="end_time" value="{{recovery.end_time}}" bindinput="recoveryField" placeholder="HH:MM"/></label><label>拔管时间<input data-field="extubation_time" value="{{recovery.extubation_time}}" bindinput="recoveryField" placeholder="HH:MM"/></label></view><view class="field-label">拔管后状态</view><view class="recovery-options"><view wx:for="{{sheet.recovery_options}}" wx:key="*this" class="{{recovery.recovery_status === item ? 'active' : ''}}" data-value="{{item}}" bindtap="setRecoveryStatus">{{item}}</view></view><label class="wide-label">复苏记录<textarea data-field="recovery_notes" value="{{recovery.recovery_notes}}" bindinput="recoveryField" placeholder="自主呼吸、吞咽反射、黏膜颜色、体温及后续观察要求"/></label><button class="finish-btn" bindtap="finish" loading="{{busy}}">结束本次麻醉监护</button></view>
      <view wx:else class="recovery-summary"><view class="summary-title">本次监护已结束</view><view>麻醉时段　{{sheet.start_time}} - {{sheet.end_time}}</view><view>拔管时间　{{sheet.extubation_time || '未填写'}}</view><view>复苏状态　{{sheet.recovery_status || '未填写'}}</view><view wx:if="{{sheet.recovery_notes}}">复苏记录　{{sheet.recovery_notes}}</view><button class="primary-btn" bindtap="openPdf">查看监护 PDF</button><button class="secondary-btn" bindtap="reopen">重新开启监护</button></view>
    </block>
  </block>
</view>
