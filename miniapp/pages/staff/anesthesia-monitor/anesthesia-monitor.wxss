@import "../../../staff.wxss";
.monitor-page{padding-bottom:60rpx}.monitor-hero{margin:0 -28rpx;padding:28rpx 30rpx;display:flex;justify-content:space-between;align-items:flex-start;background:#171717;color:#fff}.monitor-pet{margin-top:8rpx;font-size:46rpx;font-weight:750}.monitor-meta{margin-top:10rpx;color:#c5c5c1;font-size:20rpx}.monitor-status{padding:9rpx 13rpx;border:1rpx solid #777;color:#ddd;font-size:19rpx}.monitor-status.open{border-color:#77a18d;color:#a7c7b8}.monitor-reminder{margin:16rpx 0;padding:18rpx 20rpx;display:flex;justify-content:space-between;background:#edf4f0;border-left:6rpx solid #1d4d3a;color:#1d4d3a;font-size:21rpx}.monitor-reminder.late{background:#f8eeee;border-left-color:#7c302c;color:#7c302c;font-weight:700}.monitor-tabs{height:78rpx;margin:20rpx 0;display:grid;grid-template-columns:repeat(3,1fr);background:#e9e9e5}.monitor-tabs view{display:flex;align-items:center;justify-content:center;color:#666;font-size:21rpx}.monitor-tabs view.active{background:#171717;color:#fff;font-weight:700}.fold-head{min-height:76rpx;padding:0 20rpx;display:flex;align-items:center;justify-content:space-between;background:#fff;border:1rpx solid #d8d8d4;font-size:23rpx;font-weight:700}.form-panel,.vital-panel,.med-panel,.recovery-panel,.recovery-summary{padding:22rpx 20rpx;background:#fff;border:1rpx solid #d8d8d4;border-top:0}.panel-title{margin-bottom:18rpx;font-size:28rpx;font-weight:750}.form-panel label,.vital-panel label,.med-panel label,.recovery-panel label{display:block;margin-bottom:15rpx;color:#686864;font-size:19rpx}.form-panel input,.form-panel textarea,.vital-panel input,.med-panel input,.recovery-panel input,.recovery-panel textarea,.picker-box{width:100%;min-height:70rpx;margin-top:8rpx;padding:0 14rpx;border:1rpx solid #cdcdc8;background:#fff;color:#171717;font-size:23rpx;box-sizing:border-box}.form-panel textarea,.recovery-panel textarea{height:120rpx;padding-top:14rpx}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:0 14rpx}.vital-panel{border-top:1rpx solid #d8d8d4;margin-top:14rpx}.vital-grid input{text-align:center;font-size:29rpx;font-weight:700}.field-label{margin:10rpx 0;color:#686864;font-size:19rpx}.choice-row,.phase-grid,.recovery-options{display:grid;gap:9rpx;margin-bottom:16rpx}.choice-row{grid-template-columns:repeat(3,1fr)}.phase-grid,.recovery-options{grid-template-columns:repeat(2,1fr)}.choice-row view,.phase-grid view,.recovery-options view{min-height:64rpx;display:flex;align-items:center;justify-content:center;border:1rpx solid #cfcfca;background:#fff;color:#555;font-size:21rpx}.choice-row view.active,.phase-grid view.active,.recovery-options view.active{background:#171717;border-color:#171717;color:#fff}.primary-btn,.secondary-btn,.record-btn,.finish-btn{min-height:82rpx;margin:16rpx 0 0;border-radius:0;display:flex;align-items:center;justify-content:center;font-size:23rpx;font-weight:700}.primary-btn,.record-btn{background:#171717;color:#fff}.secondary-btn{background:#fff;color:#171717;border:1rpx solid #171717}.finish-btn{background:#7c302c;color:#fff}.primary-btn::after,.secondary-btn::after,.record-btn::after,.finish-btn::after{border:0}.history-head{margin-top:32rpx}.timeline-row,.med-row{margin-bottom:10rpx;padding:18rpx;display:flex;gap:15rpx;background:#fff;border:1rpx solid #d8d8d4}.timeline-time,.med-time{flex:0 0 68rpx;color:#1d4d3a;font-size:21rpx;font-weight:700}.timeline-main,.med-main{flex:1;min-width:0}.timeline-values{display:flex;flex-wrap:wrap;gap:8rpx 13rpx;font-size:21rpx}.timeline-values .bad{color:#7c302c;font-weight:700}.timeline-values .warn{color:#80511f;font-weight:700}.timeline-event,.med-sub{margin-top:7rpx;color:#74746f;font-size:19rpx;line-height:1.5}.med-notice{margin-bottom:15rpx;padding:18rpx;border-left:6rpx solid #6b4423;background:#f6f0e8;color:#59452e;font-size:20rpx;line-height:1.6}.med-panel{margin-top:14rpx;border-top:1rpx solid #d8d8d4}.picker-box{display:flex;align-items:center}.med-name{font-size:23rpx;font-weight:700}.review{align-self:flex-start;white-space:nowrap;padding:6rpx 9rpx;border:1rpx solid #b18443;color:#80511f;font-size:17rpx}.review.reviewed{border-color:#1d4d3a;color:#1d4d3a}.review.voided{border-color:#7c302c;color:#7c302c}.recovery-panel{border-top:1rpx solid #d8d8d4}.recovery-summary{border-top:1rpx solid #d8d8d4;color:#4b4b48;font-size:22rpx;line-height:2}.summary-title{margin-bottom:12rpx;color:#171717;font-size:30rpx;font-weight:750}
