@import "../../../staff.wxss";
.grooming-page{padding-bottom:150rpx}.grooming-hero{margin:0 -28rpx;padding:30rpx 32rpx;background:#171717;color:#fff}.grooming-eyebrow{font-size:19rpx;letter-spacing:4rpx;color:#9bb6aa}.grooming-title{margin-top:10rpx;font-size:46rpx;font-weight:700}.grooming-sub{margin-top:8rpx;color:#ccc;font-size:24rpx}.grooming-meta{margin:24rpx 0;border-top:1rpx solid #d8d4cc;border-bottom:1rpx solid #d8d4cc}.grooming-meta picker view{min-height:84rpx;display:flex;align-items:center;justify-content:space-between;border-bottom:1rpx solid #e6e2da}.grooming-meta picker:last-child view{border-bottom:0}.grooming-meta text,.field-grid text,.wide-field text,.note-field text{color:#6f6b65;font-size:22rpx}.grooming-search input{height:82rpx;padding:0 20rpx;border:2rpx solid #171717;background:#fff;box-sizing:border-box}.service-list{max-height:360rpx;overflow-y:auto}.service-row{min-height:82rpx;padding:15rpx 18rpx;display:flex;align-items:center;justify-content:space-between;border:1rpx solid #d8d4cc;border-top:0;background:#fff}.service-row view{display:flex;flex-direction:column}.service-row text{color:#1d4d3a;font-size:20rpx}.service-row view text{margin-top:4rpx;color:#777}.section-label{margin:26rpx 0 12rpx;color:#6f6b65;font-size:20rpx;letter-spacing:3rpx}.service-card{margin-bottom:16rpx;padding:20rpx;background:#fff;border:1rpx solid #d8d4cc}.service-head{display:flex;align-items:center;justify-content:space-between;padding-bottom:15rpx;border-bottom:1rpx solid #171717}.service-head strong{font-size:27rpx}.service-head button{height:48rpx;margin:0;padding:0 10rpx;border:0;border-radius:0;background:transparent;color:#7a2828;font-size:20rpx;line-height:48rpx}.service-head button::after{border:0}.field-grid{display:grid;grid-template-columns:1fr 1fr;gap:14rpx;margin-top:16rpx}.field-grid input,.wide-field input,.note-field input,.note-field textarea{width:100%;height:64rpx;margin-top:7rpx;padding:0 12rpx;border:1rpx solid #d8d4cc;background:#fff;box-sizing:border-box}.wide-field,.note-field{display:block;margin-top:16rpx}.note-field textarea{height:120rpx;padding-top:12rpx}.subtotal{display:flex;justify-content:space-between;margin-top:17rpx;padding-top:14rpx;border-top:1rpx solid #e2ded6}.subtotal strong{font-size:28rpx}.footer-space{height:120rpx}.submit-bar{position:fixed;left:0;right:0;bottom:0;z-index:10;display:grid;grid-template-columns:1fr 300rpx;background:#fdfcf8;border-top:1rpx solid #171717;padding-bottom:env(safe-area-inset-bottom)}.submit-bar>view{padding:14rpx 28rpx}.submit-bar text{display:block;color:#777;font-size:20rpx}.submit-bar strong{font-size:33rpx}.submit-bar button{height:100%;min-height:90rpx;border-radius:0;background:#171717;color:#fff;display:flex;align-items:center;justify-content:center}
