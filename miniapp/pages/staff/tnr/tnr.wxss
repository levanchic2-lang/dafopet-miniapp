@import "../../../staff.wxss";
.tnr-page{padding-left:20rpx;padding-right:20rpx}.tnr-head{margin:0 -20rpx 24rpx;padding:28rpx 30rpx 30rpx;background:#fff;border-top:1rpx solid #deded9;border-bottom:1rpx solid #deded9}.tnr-title{margin-top:8rpx;font-size:48rpx;font-weight:750}.tnr-desc{margin-top:8rpx;color:#737373;font-size:23rpx}.tnr-card{margin-bottom:20rpx;padding:24rpx;background:#fff;border:1rpx solid #d8d8d4}.tnr-card-head{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.tnr-time{margin-right:16rpx;color:#1d4d3a;font-size:23rpx;font-weight:700}.tnr-name{font-size:31rpx;font-weight:750}.tnr-state{padding:7rpx 10rpx;border:1rpx solid #a86b67;color:#7c302c;font-size:18rpx;white-space:nowrap}.tnr-state.verified{border-color:#779284;color:#1d4d3a}.tnr-state.done{background:#1d4d3a;border-color:#1d4d3a;color:#fff}.tnr-meta{margin-top:10rpx;color:#737373;font-size:21rpx}.tnr-subhead{margin-top:22rpx;padding-top:18rpx;border-top:1rpx solid #e1e1dc;display:flex;justify-content:space-between;font-size:21rpx}.tnr-subhead text:last-child{color:#8a8a85;font-size:19rpx}.tnr-images{margin-top:12rpx;white-space:nowrap;width:100%}.tnr-images image{display:inline-block;width:150rpx;height:150rpx;margin-right:10rpx;background:#eee}.tnr-no-image{margin-top:12rpx;padding:24rpx;background:#f3f3f0;color:#858580;font-size:20rpx}.tnr-progress{display:grid;grid-template-columns:repeat(3,1fr);margin:22rpx 0 16rpx;border:1rpx solid #deded9}.tnr-progress view{padding:14rpx 5rpx;text-align:center;border-right:1rpx solid #deded9;color:#999}.tnr-progress view:last-child{border-right:0}.tnr-progress strong{display:block;font-size:18rpx}.tnr-progress text{display:block;margin-top:4rpx;font-size:19rpx}.tnr-progress view.active{background:#edf4f0;color:#1d4d3a}.tnr-primary,.tnr-complete{height:78rpx;margin:12rpx 0 0;border:0;border-radius:0;display:flex;align-items:center;justify-content:center;background:#171717;color:#fff;font-size:23rpx;font-weight:700}.tnr-primary::after,.tnr-complete::after,.tnr-upload-row button::after{border:0}.tnr-upload-row{display:grid;grid-template-columns:1.35fr 1fr;gap:10rpx;margin-top:12rpx}.tnr-upload-row button{height:74rpx;margin:0;padding:0;border-radius:0;border:1rpx solid #bfc2bc;background:#fff;color:#171717;font-size:21rpx;display:flex;align-items:center;justify-content:center}.tnr-upload-row button:first-child{border-color:#1d4d3a;color:#1d4d3a;font-weight:700}.tnr-complete{background:#1d4d3a}.tnr-complete.disabled{background:#e7e7e3;color:#8a8a85;font-weight:400}.tnr-finished{margin-top:14rpx;padding:19rpx;text-align:center;background:#edf4f0;color:#1d4d3a;font-size:22rpx;font-weight:700}.tnr-tip{margin-top:14rpx;padding:14rpx 16rpx;border-left:4rpx solid #1d4d3a;background:#f3f6f4;color:#626762;font-size:20rpx;line-height:1.55}
