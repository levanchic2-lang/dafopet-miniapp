@import "../../../staff.wxss";
.materials-page{padding-bottom:50rpx}.materials-head{margin:0 -28rpx 24rpx;padding:28rpx 32rpx 30rpx;background:#fff;border-top:1rpx solid #deded9;border-bottom:1rpx solid #deded9}.materials-title{margin-top:8rpx;font-size:48rpx;font-weight:750}.materials-desc{margin-top:10rpx;color:#737373;font-size:22rpx;line-height:1.6}.material-visit{min-height:132rpx;margin-bottom:12rpx;padding:20rpx 18rpx;display:grid;grid-template-columns:90rpx 1fr 78rpx;gap:14rpx;align-items:center;background:#fff;border:1rpx solid #d8d8d4;box-sizing:border-box}.material-visit.today{border-left:6rpx solid #1d4d3a}.material-date{color:#1d4d3a;font-size:20rpx}.material-main{min-width:0}.material-name{font-size:28rpx;font-weight:750}.material-diagnosis,.material-meta{margin-top:6rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.material-diagnosis{color:#454545;font-size:22rpx}.material-meta{color:#858580;font-size:19rpx}.material-count{text-align:right;color:#858580}.material-count strong,.material-count text{display:block}.material-count strong{color:#171717;font-size:28rpx}.material-count text{margin-top:4rpx;font-size:18rpx}
