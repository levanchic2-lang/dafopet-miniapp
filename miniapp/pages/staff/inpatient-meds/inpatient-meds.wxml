<view class="staff-page med-page">
  <view class="staff-status"><text>员工端</text><text>住院护理</text></view>
  <view class="med-head"><view class="staff-eyebrow">INPATIENT MEDICATION</view><view class="med-title">住院用药</view><view class="med-desc">普通处方按上午、下午、晚上执行；医生指定具体时刻时按定点执行。打勾不会再次扣库存。</view></view>
  <view class="med-tabs"><view class="med-tab {{view === 'pending' ? 'active' : ''}}" data-view="pending" bindtap="setView">待执行</view><view class="med-tab {{view === 'completed' ? 'active' : ''}}" data-view="completed" bindtap="setView">已完成</view><view class="med-tab {{view === 'temporary' ? 'active' : ''}}" data-view="temporary" bindtap="setView">待补处方</view></view>

  <view wx:if="{{loading}}" class="staff-loading">正在读取用药任务…</view>
  <view wx:if="{{error}}" class="staff-error">{{error}}</view>

  <block wx:if="{{view === 'pending' && !loading}}">
    <view class="staff-section-head"><text>按住院动物归组</text><text class="staff-section-meta">{{groups.length}} 只 · {{items.length}} 项</text></view>
    <view wx:if="{{!items.length}}" class="staff-empty">当前没有待执行的住院用药。</view>
    <view wx:for="{{groups}}" wx:key="hospitalization_id" wx:for-item="group" class="pet-med-group {{group.overdue_count ? 'overdue' : ''}}">
      <view class="pet-group-head" data-hospitalization-id="{{group.hospitalization_id}}" bindtap="toggleGroup">
        <view class="pet-group-main">
          <view class="pet-group-name">{{group.pet_name}}{{group.cage_code ? ' · ' + group.cage_code : ''}}</view>
          <view class="pet-group-meta">{{group.overdue_count ? '逾期 ' + group.overdue_count + ' 项' : '下一次 ' + group.next_time}} · 待执行 {{group.total_count}} 项</view>
        </view>
        <view class="pet-group-side"><text class="pet-group-count">{{group.total_count}}</text><text>{{group.expanded ? '收起' : '展开'}}</text></view>
      </view>

      <view wx:if="{{group.expanded}}" class="pet-group-detail">
        <view wx:for="{{group.time_groups}}" wx:key="key" wx:for-item="slot" class="med-slot">
          <view class="med-slot-head">
            <view><text class="med-slot-time">{{slot.time}}</text><text class="med-slot-date">{{slot.date}}{{slot.schedule_mode === 'exact' ? ' · 定点' : ' · 时段'}}</text></view>
            <view class="slot-select" data-hospitalization-id="{{group.hospitalization_id}}" data-time-key="{{slot.key}}" catchtap="toggleTimeGroup">{{slot.all_selected ? '取消全选' : '全选本轮'}}</view>
          </view>
          <view wx:for="{{slot.items}}" wx:key="id" wx:for-item="med" class="med-compact-row {{med.is_overdue ? 'overdue-row' : ''}}">
            <view class="med-check {{med.selected ? 'checked' : ''}}" data-id="{{med.id}}" catchtap="toggleMedication">{{med.selected ? '✓' : ''}}</view>
            <view class="med-compact-body" data-id="{{med.id}}" catchtap="toggleMedication">
              <view class="med-compact-title">{{med.drug_name}}</view>
              <view class="med-compact-meta">{{med.dose || '剂量未填'}}{{med.route ? ' · ' + med.route : ''}}{{med.frequency ? ' · ' + med.frequency : ''}} · 第{{med.day_index}}天第{{med.dose_index}}次</view>
              <view wx:if="{{med.instructions}}" class="med-note">备注：{{med.instructions}}</view>
            </view>
            <view class="med-row-actions">
              <button class="med-row-action" data-id="{{med.id}}" catchtap="skipTask">跳过</button>
              <button wx:if="{{canDiscontinue}}" class="med-row-action stop" data-id="{{med.id}}" data-drug="{{med.drug_name}}" catchtap="discontinueTask">停药</button>
            </view>
          </view>
        </view>
        <button class="batch-complete {{group.selected_count ? '' : 'disabled'}}" data-hospitalization-id="{{group.hospitalization_id}}" catchtap="batchComplete" disabled="{{!group.selected_count}}">确认完成 {{group.selected_count}} 项</button>
      </view>
    </view>
  </block>

  <block wx:if="{{view === 'completed' && !loading}}">
    <view class="med-group-modes">
      <view class="med-group-mode {{completedGroupMode === 'time' ? 'active' : ''}}" data-mode="time" bindtap="setCompletedGroupMode">时间</view>
      <view class="med-group-mode {{completedGroupMode === 'pet' ? 'active' : ''}}" data-mode="pet" bindtap="setCompletedGroupMode">动物</view>
      <view class="med-group-mode {{completedGroupMode === 'pet_date' ? 'active' : ''}}" data-mode="pet_date" bindtap="setCompletedGroupMode">动物+日期</view>
    </view>
    <view class="staff-section-head"><text>按{{completedGroupLabel}}分组</text><text class="staff-section-meta">{{items.length}} 项</text></view>
    <view wx:if="{{!items.length}}" class="staff-empty">暂无已完成记录。</view>
    <view wx:for="{{groups}}" wx:key="key" wx:for-item="group" class="pet-med-group">
      <view class="pet-group-head" data-group-key="{{group.key}}" bindtap="toggleCompletedGroup">
        <view class="pet-group-main">
          <view class="pet-group-name">{{group.title}}</view>
          <view class="pet-group-meta">{{group.subtitle}} · {{group.total_count}} 项</view>
        </view>
        <view class="pet-group-side"><text class="pet-group-count">{{group.total_count}}</text><text>{{group.expanded ? '收起' : '展开'}}</text></view>
      </view>
      <view wx:if="{{group.expanded}}" class="pet-group-detail">
        <view wx:for="{{group.date_groups}}" wx:key="key" wx:for-item="dateGroup">
          <view wx:if="{{dateGroup.label}}" class="med-date-divider">{{dateGroup.label}}</view>
          <view wx:for="{{dateGroup.time_groups}}" wx:key="key" wx:for-item="slot" class="med-slot">
            <view class="med-slot-head"><view><text class="med-slot-time">{{slot.time}}</text><text wx:if="{{slot.date}}" class="med-slot-date">{{slot.date}}</text></view></view>
            <view wx:for="{{slot.items}}" wx:key="id" wx:for-item="med" class="med-compact-row">
              <view class="med-compact-body">
                <view wx:if="{{completedGroupMode === 'time'}}" class="completed-pet-line">{{med.pet_name}}{{med.cage_code ? ' · ' + med.cage_code : ''}}</view>
                <view class="med-compact-title">{{med.drug_name}}</view>
                <view class="med-compact-meta">{{med.dose || '剂量未填'}}{{med.route ? ' · ' + med.route : ''}}{{med.frequency ? ' · ' + med.frequency : ''}} · 第{{med.day_index}}天第{{med.dose_index}}次</view>
                <view wx:if="{{med.instructions}}" class="med-note">备注：{{med.instructions}}</view>
                <view class="med-note">{{med.status === 'done' ? '已执行' : (med.status === 'cancelled' ? '已停药' : '已跳过')}} · {{med.administered_by}} · {{med.administered_at}}{{med.notes ? ' · ' + med.notes : ''}}</view>
              </view>
              <button wx:if="{{med.status !== 'cancelled'}}" class="med-row-action" data-id="{{med.id}}" catchtap="undoTask">撤销</button>
            </view>
          </view>
        </view>
      </view>
    </view>
  </block>

  <block wx:if="{{view === 'temporary' && !loading}}">
    <view class="temporary-guide"><view class="guide-title">药已使用，但医生还没来得及开处方</view><view>先记录执行事实，列入待补处方。此处不扣库存，医生补开正式处方时统一扣减，避免重复。</view></view>
    <button class="add-temporary" bindtap="openTemporaryForm">记录一次临时用药</button>
    <view class="staff-section-head"><text>待医生补处方</text><text class="staff-section-meta">{{temporary.length}} 条</text></view>
    <view wx:if="{{!temporary.length}}" class="staff-empty">当前没有待补处方的临时用药。</view>
    <view wx:for="{{temporary}}" wx:key="id" class="temp-row"><view class="temp-main"><view class="med-pet">{{item.pet_name}}</view><view class="med-drug">{{item.drug_name}} · {{item.dose_actual}}</view><view class="med-meta">{{item.route}} · 医嘱 {{item.ordered_by}} · 执行 {{item.administered_by}}</view><view class="med-note">{{item.administered_at}}{{item.notes ? ' · ' + item.notes : ''}}</view></view><button data-id="{{item.id}}" bindtap="voidTemporary">作废</button></view>
  </block>
</view>

<view wx:if="{{showTemporaryForm}}" class="sheet-mask" bindtap="closeTemporaryForm"></view>
<view wx:if="{{showTemporaryForm}}" class="temporary-sheet">
  <view class="sheet-grip"></view><view class="sheet-title">记录临时用药</view><view class="sheet-warning">仅用于已经实际给药、但处方尚未开出的情况。</view>
  <view class="form-label">住院动物</view><picker range="{{hospitalizations}}" range-key="label" value="{{form.hospitalizationIndex}}" bindchange="onHospChange"><view class="form-picker">{{selectedHospLabel || '请选择'}}</view></picker>
  <view class="form-label">药品</view><input class="form-input" placeholder="输入药名搜索" value="{{drugQuery}}" bindinput="onDrugQuery"/><view wx:if="{{filteredInventory.length && !selectedDrug}}" class="drug-results"><view wx:for="{{filteredInventory}}" wx:key="id" data-id="{{item.id}}" bindtap="selectDrug"><text>{{item.name}}</text><text>{{item.stock_qty}}{{item.unit}}</text></view></view>
  <view wx:if="{{selectedDrug}}" class="selected-drug">{{selectedDrug.name}} · 当前 {{selectedDrug.stock_qty}}{{selectedDrug.unit}}</view>
  <view class="form-label">实际剂量</view><input class="form-input" placeholder="例如 5μg、0.2ml、1片" value="{{form.dose_actual}}" bindinput="onDoseInput"/>
  <view class="form-label">给药途径</view><picker range="{{routes}}" value="{{form.routeIndex}}" bindchange="onRouteChange"><view class="form-picker">{{selectedRoute}}</view></picker>
  <view class="form-label">口头医嘱医生</view><picker range="{{doctors}}" value="{{form.doctorIndex}}" bindchange="onDoctorChange"><view class="form-picker">{{selectedDoctor || '请选择医生'}}</view></picker>
  <view class="form-label">备注</view><textarea class="form-textarea" placeholder="可选：临时用药原因、动物反应" value="{{form.notes}}" bindinput="onNotesInput"/>
  <button class="submit-temporary" bindtap="submitTemporary" loading="{{busy}}">确认已经给药并记录</button><button class="cancel-temporary" bindtap="closeTemporaryForm">取消</button>
</view>
