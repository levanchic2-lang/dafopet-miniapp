@import "../../../staff.wxss";
.med-page{padding-bottom:50rpx}.med-head{margin:0 -28rpx 24rpx;padding:28rpx 32rpx 30rpx;background:#fff;border-top:1rpx solid #deded9;border-bottom:1rpx solid #deded9}.med-title{margin-top:8rpx;font-size:48rpx;font-weight:750}.med-desc{margin-top:10rpx;color:#737373;font-size:22rpx;line-height:1.6}.med-tabs{display:grid;grid-template-columns:repeat(3,1fr);margin-bottom:28rpx;border:1rpx solid #d8d4cc}.med-tab{padding:21rpx 0;text-align:center;color:#777;font-size:24rpx}.med-tab.active{background:#171717;color:#fff;font-weight:700}.med-task{margin-bottom:14rpx;padding:22rpx 18rpx;display:grid;grid-template-columns:96rpx 1fr;gap:16rpx;background:#fff;border:1rpx solid #d8d8d4;box-sizing:border-box}.med-task.overdue{border-left:7rpx solid #7a2828}.med-time view{font-size:31rpx;font-weight:750}.med-time text{display:block;margin-top:5rpx;color:#858580;font-size:18rpx}.med-body{min-width:0}.med-pet{color:#1d4d3a;font-size:21rpx}.med-drug{margin-top:5rpx;font-size:29rpx;font-weight:750}.med-meta,.med-note{margin-top:7rpx;color:#6f6f6b;font-size:20rpx;line-height:1.5}.med-actions{grid-column:1/-1;display:grid;grid-template-columns:2fr 1fr;gap:12rpx}.med-actions button,.med-undo{height:70rpx;border-radius:0;font-size:23rpx;line-height:70rpx}.med-actions button::after,.med-undo::after{border:0}.med-done{background:#171717;color:#fff}.med-skip,.med-undo{background:#fff;color:#7a2828;border:1rpx solid #b98e8e}.med-undo{grid-column:1/-1;width:100%;margin:0}.temporary-guide{margin-bottom:18rpx;padding:22rpx;background:#eef5f1;border-left:6rpx solid #1d4d3a;color:#4a4a4a;font-size:21rpx;line-height:1.6}.guide-title{margin-bottom:6rpx;color:#171717;font-size:25rpx;font-weight:700}.add-temporary{height:82rpx;margin:0 0 28rpx;border-radius:0;background:#171717;color:#fff;font-size:25rpx;line-height:82rpx}.add-temporary::after{border:0}.temp-row{margin-bottom:12rpx;padding:22rpx;display:flex;align-items:center;gap:14rpx;background:#fff;border:1rpx solid #d8d8d4}.temp-main{flex:1;min-width:0}.temp-row button{width:92rpx;height:62rpx;margin:0;padding:0;border-radius:0;background:#fff;color:#7a2828;border:1rpx solid #b98e8e;font-size:20rpx;line-height:62rpx}.temp-row button::after{border:0}.sheet-mask{position:fixed;z-index:50;inset:0;background:rgba(0,0,0,.52)}.temporary-sheet{position:fixed;z-index:51;left:0;right:0;bottom:0;max-height:88vh;padding:18rpx 30rpx calc(28rpx + env(safe-area-inset-bottom));overflow-y:auto;background:#fff;box-sizing:border-box}.sheet-grip{width:70rpx;height:6rpx;margin:0 auto 20rpx;background:#bdbdb8}.sheet-title{font-size:36rpx;font-weight:750}.sheet-warning{margin:10rpx 0 22rpx;color:#7a2828;font-size:20rpx}.form-label{margin:18rpx 0 8rpx;color:#737373;font-size:20rpx}.form-input,.form-picker,.form-textarea{width:100%;padding:20rpx;background:#fff;border:1rpx solid #cfcfca;box-sizing:border-box;font-size:24rpx}.form-picker{min-height:74rpx}.form-textarea{height:110rpx}.drug-results{max-height:310rpx;overflow-y:auto;border:1rpx solid #cfcfca;border-top:0}.drug-results view{min-height:70rpx;padding:14rpx 18rpx;display:flex;align-items:center;justify-content:space-between;border-bottom:1rpx solid #e2e2de;font-size:22rpx}.drug-results text:last-child{color:#858580}.selected-drug{padding:16rpx 18rpx;background:#eef5f1;color:#1d4d3a;font-size:22rpx}.submit-temporary,.cancel-temporary{height:82rpx;margin-top:24rpx;border-radius:0;font-size:24rpx;line-height:82rpx}.submit-temporary{background:#171717;color:#fff}.cancel-temporary{margin-top:12rpx;background:#fff;color:#555;border:1rpx solid #cfcfca}.submit-temporary::after,.cancel-temporary::after{border:0}
