@import "../../../staff.wxss";

.med-row-actions{display:flex;flex:none;flex-direction:column;gap:6rpx}
.med-row-actions .med-row-action{width:82rpx;height:48rpx;font-size:19rpx;line-height:48rpx}
.med-row-actions .med-row-action.stop{background:#682121;color:#fff}
.med-page{padding-bottom:50rpx}.med-head{margin:0 -28rpx 24rpx;padding:28rpx 32rpx 30rpx;background:#fff;border-top:1rpx solid #deded9;border-bottom:1rpx solid #deded9}.med-title{margin-top:8rpx;font-size:48rpx;font-weight:750}.med-desc{margin-top:10rpx;color:#4a4a4a;font-size:22rpx;line-height:1.6}.med-tabs{display:grid;grid-template-columns:repeat(3,1fr);margin-bottom:28rpx;border:1rpx solid #d8d4cc}.med-tab{padding:21rpx 0;text-align:center;color:#4a4a4a;font-size:24rpx}.med-tab.active{background:#171717;color:#fff;font-weight:700}.pet-med-group{margin-bottom:14rpx;background:#fff;border:1rpx solid #d8d8d4}.pet-med-group.overdue{border-left:6rpx solid #7a2828}.pet-group-head{min-height:104rpx;padding:20rpx 22rpx;display:flex;align-items:center;justify-content:space-between;gap:20rpx;box-sizing:border-box}.pet-group-main{min-width:0;flex:1}.pet-group-name{color:#111;font-size:31rpx;font-weight:750}.pet-group-meta{margin-top:7rpx;color:#363632;font-size:21rpx;font-weight:600}.pet-group-side{flex:none;display:flex;align-items:center;gap:13rpx;color:#3f3f3b;font-size:20rpx}.pet-group-count{min-width:50rpx;color:#111;font-size:32rpx;font-weight:750;text-align:right}.pet-group-detail{border-top:1rpx solid #c9c6bf}.med-slot+.med-slot{border-top:1rpx solid #c9c6bf}.med-slot-head{min-height:68rpx;padding:0 20rpx;display:flex;align-items:center;justify-content:space-between;background:#eeeae3}.med-slot-time{color:#111;font-size:27rpx;font-weight:750}.med-slot-date{margin-left:14rpx;color:#383834;font-size:20rpx;font-weight:600}.slot-select{padding:15rpx 0 15rpx 22rpx;color:#174333;font-size:21rpx;font-weight:700}.med-compact-row{min-height:94rpx;padding:15rpx 18rpx;display:flex;align-items:center;gap:15rpx;border-top:1rpx solid #dedbd5;box-sizing:border-box}.med-compact-row.overdue-row .med-compact-title{color:#111}.med-check{width:40rpx;height:40rpx;flex:none;border:2rpx solid #5f5f59;box-sizing:border-box;color:#fff;font-size:25rpx;line-height:36rpx;text-align:center}.med-check.checked{background:#174333;border-color:#174333}.med-compact-body{min-width:0;flex:1}.med-compact-title{overflow:hidden;color:#111;font-size:26rpx;font-weight:750;text-overflow:ellipsis;white-space:nowrap}.med-compact-meta{margin-top:6rpx;color:#292925;font-size:20rpx;font-weight:600;line-height:1.5}.med-note{margin-top:7rpx;color:#20201d;font-size:20rpx;font-weight:600;line-height:1.5}.med-row-action{width:82rpx;height:58rpx;flex:none;margin:0;padding:0;border-radius:0;background:#fff;color:#682121;border:1rpx solid #8f5555;font-size:20rpx;font-weight:600;line-height:58rpx}.med-row-action::after{border:0}.batch-complete{height:76rpx;margin:18rpx;background:#171717;color:#fff;border-radius:0;font-size:23rpx;line-height:76rpx}.batch-complete::after{border:0}.batch-complete.disabled{background:#c9c6bf;color:#555}.med-pet{color:#174333;font-size:21rpx}.med-drug{margin-top:5rpx;color:#111;font-size:29rpx;font-weight:750}.temporary-guide{margin-bottom:18rpx;padding:22rpx;background:#eef5f1;border-left:6rpx solid #174333;color:#333;font-size:21rpx;line-height:1.6}.guide-title{margin-bottom:6rpx;color:#111;font-size:25rpx;font-weight:700}.add-temporary{height:82rpx;margin:0 0 28rpx;border-radius:0;background:#171717;color:#fff;font-size:25rpx;line-height:82rpx}.add-temporary::after{border:0}.temp-row{margin-bottom:12rpx;padding:22rpx;display:flex;align-items:center;gap:14rpx;background:#fff;border:1rpx solid #c9c6bf}.temp-main{flex:1;min-width:0}.temp-row button{width:92rpx;height:62rpx;margin:0;padding:0;border-radius:0;background:#fff;color:#682121;border:1rpx solid #8f5555;font-size:20rpx;line-height:62rpx}.temp-row button::after{border:0}.sheet-mask{position:fixed;z-index:50;inset:0;background:rgba(0,0,0,.52)}.temporary-sheet{position:fixed;z-index:51;left:0;right:0;bottom:0;max-height:88vh;padding:18rpx 30rpx calc(28rpx + env(safe-area-inset-bottom));overflow-y:auto;background:#fff;box-sizing:border-box}.sheet-grip{width:70rpx;height:6rpx;margin:0 auto 20rpx;background:#888}.sheet-title{color:#111;font-size:36rpx;font-weight:750}.sheet-warning{margin:10rpx 0 22rpx;color:#682121;font-size:20rpx;font-weight:600}.form-label{margin:18rpx 0 8rpx;color:#333;font-size:20rpx;font-weight:600}.form-input,.form-picker,.form-textarea{width:100%;padding:20rpx;background:#fff;border:1rpx solid #aaa79f;box-sizing:border-box;color:#111;font-size:24rpx}.form-picker{min-height:74rpx}.form-textarea{height:110rpx}.drug-results{max-height:310rpx;overflow-y:auto;border:1rpx solid #aaa79f;border-top:0}.drug-results view{min-height:70rpx;padding:14rpx 18rpx;display:flex;align-items:center;justify-content:space-between;border-bottom:1rpx solid #d5d2cb;color:#222;font-size:22rpx}.drug-results text:last-child{color:#444}.selected-drug{padding:16rpx 18rpx;background:#eef5f1;color:#174333;font-size:22rpx;font-weight:600}.submit-temporary,.cancel-temporary{height:82rpx;margin-top:24rpx;border-radius:0;font-size:24rpx;line-height:82rpx}.submit-temporary{background:#171717;color:#fff}.cancel-temporary{margin-top:12rpx;background:#fff;color:#333;border:1rpx solid #aaa79f}.submit-temporary::after,.cancel-temporary::after{border:0}
