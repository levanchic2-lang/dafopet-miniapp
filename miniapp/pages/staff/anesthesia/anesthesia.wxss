@import "../../../staff.wxss";
.anesthesia-list-page{padding-bottom:50rpx}.anesthesia-head{margin:0 -28rpx 24rpx;padding:28rpx 32rpx 30rpx;background:#fff;border-top:1rpx solid #deded9;border-bottom:1rpx solid #deded9}.anesthesia-title{margin-top:8rpx;font-size:48rpx;font-weight:750}.anesthesia-desc{margin-top:10rpx;color:#737373;font-size:22rpx;line-height:1.6}.active-monitor{margin-bottom:12rpx;padding:25rpx 22rpx;display:flex;align-items:center;justify-content:space-between;background:#171717;color:#fff}.active-name{font-size:31rpx;font-weight:750}.active-meta{margin-top:8rpx;color:#bdbdb9;font-size:20rpx}.active-live{color:#b9d0c5;font-size:21rpx}.staff-search{margin-top:28rpx}.anesthesia-visit{min-height:138rpx;margin-bottom:12rpx;padding:20rpx 18rpx;display:grid;grid-template-columns:78rpx 1fr 86rpx;gap:13rpx;align-items:center;background:#fff;border:1rpx solid #d8d8d4;box-sizing:border-box}.anesthesia-visit.today{border-left:6rpx solid #1d4d3a}.visit-date{color:#1d4d3a;font-size:19rpx}.visit-main{min-width:0}.visit-name{font-size:28rpx;font-weight:750}.visit-diagnosis,.visit-meta{margin-top:6rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.visit-diagnosis{color:#454545;font-size:21rpx}.visit-meta{color:#858580;font-size:18rpx}.anesthesia-visit button{height:58rpx;margin:0;padding:0;border-radius:0;background:#fff;border:1rpx solid #171717;color:#171717;font-size:20rpx;line-height:58rpx}.anesthesia-visit button::after{border:0}
