@import "../../../staff.wxss";
@import "../record-detail.wxss";
.grooming-create{height:78rpx;margin:0 0 18rpx;border:0;border-radius:0;background:#171717;color:#fff;font-size:23rpx;font-weight:700;display:flex;align-items:center;justify-content:center;line-height:1.2}.grooming-create::after{border:0}
.prevention-actions{display:grid;grid-template-columns:1fr 1fr;gap:12rpx;margin-bottom:18rpx}.prevention-actions button{height:78rpx;margin:0;border:0;border-radius:0;background:#171717;color:#fff;font-size:23rpx;font-weight:700;display:flex;align-items:center;justify-content:center;line-height:1.2}.prevention-actions button:last-child{background:#fff;color:#171717;border:1rpx solid #171717}.prevention-actions button::after{border:0}
.prescription-block{padding:0}.prescription-head{padding:20rpx 22rpx 18rpx;display:flex;align-items:flex-start;justify-content:space-between;gap:16rpx;background:#f7f5f0;border-bottom:1rpx solid #ddd8cf}.prescription-no{margin-top:7rpx;color:#242424;font-size:22rpx;font-weight:700}.prescription-status{flex:0 0 auto;padding:6rpx 10rpx;border:1rpx solid #9eb9ac;color:#1d4d3a;font-size:18rpx}.prescription-status.voided{border-color:#cba8a5;color:#7c302c}.prescription-items{padding:0 22rpx}.prescription-item{padding:19rpx 0;border-bottom:1rpx solid #e2dfd8}.prescription-item:last-child{border-bottom:0}.prescription-drug{color:#1b1b1b;font-size:25rpx;font-weight:700;line-height:1.4}.prescription-usage{margin-top:8rpx;color:#30302e;font-size:22rpx;line-height:1.55}.prescription-missing{margin-top:8rpx;color:#8a5a2b;font-size:20rpx}.prescription-quantity{margin-top:6rpx;color:#66625d;font-size:20rpx}.prescription-note{margin-top:6rpx;color:#4d4b47;font-size:20rpx;line-height:1.55;white-space:pre-wrap}.prescription-order-note{padding:16rpx 22rpx;border-top:1rpx solid #ddd8cf;background:#faf9f6;color:#4d4b47;font-size:20rpx;line-height:1.55;white-space:pre-wrap}
