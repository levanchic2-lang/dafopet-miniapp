.card {
  background: #ffffff;
  margin: 20rpx;
  padding: 28rpx;
  border: 1rpx solid #cbc9c3;
  border-radius: 4rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  color: #171717;
}

.sub {
  margin-top: 12rpx;
  margin-bottom: 20rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #666666;
}

.empty,
.error {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #666666;
}

.error {
  color: #7a2828;
}

.item {
  margin-top: 20rpx;
  padding: 24rpx;
  border-radius: 4rpx;
  background: #ffffff;
  border: 1rpx solid #d8d8d4;
}

.item-highlight {
  border-color: #171717;
}

.item-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.item-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #171717;
}

.item-status {
  font-size: 24rpx;
  color: #1d4d3a;
}

.line {
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #333333;
}

.line-muted {
  color: #777777;
}

.status-cancelled {
  color: #777777;
}

.btn-cancel {
  font-size: 26rpx;
  padding: 12rpx 28rpx;
  border-radius: 4rpx;
  background: #f8eded;
  color: #7a2828;
  border: 1rpx solid #d8bcbc;
  line-height: 1.5;
}

.btn-edit {
  font-size: 26rpx;
  padding: 12rpx 28rpx;
  border-radius: 4rpx;
  background: #ffffff;
  color: #171717;
  border: 1rpx solid #cbc9c3;
  line-height: 1.5;
}
