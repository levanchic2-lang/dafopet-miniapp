.card {
  background: #ffffff;
  margin: 20rpx;
  padding: 28rpx;
  border: 1rpx solid #cbc9c3;
  border-radius: 4rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  color: #171717;
}

.sub {
  margin-top: 12rpx;
  margin-bottom: 20rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #666666;
}

.tip {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #4f4f4f;
}

.tip.light {
  color: #8a6a00;
}

.label {
  margin-top: 20rpx;
  margin-bottom: 10rpx;
  font-size: 26rpx;
  color: #171717;
  font-weight: 600;
}

.row2 {
  display: flex;
  gap: 16rpx;
}

.col {
  flex: 1;
}

.input,
.picker,
.textarea {
  width: 100%;
  min-height: 88rpx;
  box-sizing: border-box;
  padding: 22rpx 24rpx;
  border: 1rpx solid #cbc9c3;
  border-radius: 4rpx;
  background: #ffffff;
  font-size: 28rpx;
  color: #171717;
}

.textarea {
  min-height: 180rpx;
}

.slot-wrap {
  margin-top: 18rpx;
}

.slot-title {
  font-size: 24rpx;
  color: #666666;
}

.slot-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 14rpx;
}

.slot-item {
  padding: 14rpx 20rpx;
  border-radius: 2rpx;
  border: 1rpx solid #cbc9c3;
  background: #ffffff;
  font-size: 26rpx;
  color: #333333;
}

.slot-item.active {
  border-color: #171717;
  background: #171717;
  color: #ffffff;
}

/* ── 美容时长 & 时段 ── */
.beauty-duration-card {
  margin-top: 8rpx;
  padding: 20rpx 24rpx;
  border-radius: 4rpx;
  background: #faf4e8;
  border: 1rpx solid #d8d4cc;
}

.beauty-duration-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.beauty-duration-label {
  font-size: 26rpx;
  color: #6b4423;
  font-weight: 600;
}

.beauty-duration-value {
  font-size: 30rpx;
  font-weight: 800;
  color: #6b4423;
}

.beauty-disclaimer {
  margin-top: 16rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: #6b4423;
  padding: 0 4rpx;
}

/* ── 锁定字段 ── */
.picker-locked {
  background: #f7f7f5;
  color: #777777;
  border-color: #d8d8d4;
}

.picker-placeholder {
  color: #777777;
}

/* ── 美容附加服务 ── */
.addon-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 4rpx;
}

.addon-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 16rpx 24rpx;
  border-radius: 2rpx;
  border: 1rpx solid #cbc9c3;
  background: #ffffff;
  font-size: 26rpx;
  color: #333333;
}

.addon-item.addon-checked {
  border-color: #171717;
  background: #171717;
  color: #ffffff;
}

.addon-check {
  width: 28rpx;
  height: 28rpx;
  font-size: 22rpx;
  line-height: 28rpx;
  text-align: center;
}

/* ── 代预约信息卡片 ── */
.proxy-info-card {
  margin-top: 16rpx;
  padding: 24rpx;
  background: #faf4e8;
  border: 1rpx solid #d8d4cc;
  border-radius: 4rpx;
}
.proxy-info-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #6b4423;
}
.placeholder-sm {
  font-size: 24rpx;
  color: #777777;
}

.btn {
  margin-top: 28rpx;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 4rpx;
  background: #171717;
  color: #ffffff;
  font-size: 30rpx;
}

/* 老顾客识别 banner */
.profile-banner {
  margin: 18rpx 0 24rpx;
  padding: 24rpx 28rpx;
  border-radius: 4rpx;
}
.profile-banner-ok {
  background: #edf5f0;
  border-left: 6rpx solid #1d4d3a;
}
.profile-banner-tip {
  background: #faf4e8;
  border-left: 6rpx solid #6b4423;
}
.profile-banner-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #171717;
  margin-bottom: 6rpx;
}
.profile-banner-sub {
  font-size: 24rpx;
  color: #5f5f5b;
  margin-bottom: 14rpx;
}
.profile-pet-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 10rpx;
}
.profile-pet-chip {
  padding: 14rpx 22rpx;
  background: #ffffff;
  border: 1rpx solid #cbc9c3;
  border-radius: 2rpx;
  font-size: 26rpx;
}
.profile-pet-chip .chip-name {
  font-weight: 700;
  color: #171717;
  margin-right: 8rpx;
}
.profile-pet-chip .chip-meta {
  color: #666666;
  font-size: 22rpx;
}
.profile-pet-chip.selected {
  background: #171717;
  border-color: #171717;
}
.profile-pet-chip.selected .chip-name,
.profile-pet-chip.selected .chip-meta {
  color: #ffffff;
}
.profile-pet-empty {
  font-size: 24rpx;
  color: #777777;
  font-style: italic;
  margin-top: 4rpx;
}
.profile-bind-btn {
  display: inline-block;
  margin-top: 12rpx;
  padding: 14rpx 30rpx;
  background: #171717;
  color: #ffffff;
  border-radius: 4rpx;
  font-size: 26rpx;
  font-weight: 700;
}
