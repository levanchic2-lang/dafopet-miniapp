.page{padding:28rpx 28rpx 80rpx;background:#f5f3ef;min-height:100vh;color:#1a1a1a}.head{padding:12rpx 4rpx 30rpx;border-bottom:1rpx solid #222}.kicker{font-size:19rpx;letter-spacing:4rpx;color:#888}.title{font-family:serif;font-size:46rpx;font-weight:700;margin-top:10rpx}.desc{font-size:23rpx;color:#777;margin-top:10rpx;line-height:1.6}.section{background:#fff;border:1rpx solid #d8d4cc;padding:28rpx 26rpx;margin-top:24rpx}.section-title{font-family:serif;font-size:32rpx;font-weight:700;border-bottom:1rpx solid #ddd;padding-bottom:18rpx;margin-bottom:22rpx}.section-title text{font-size:22rpx;color:#888;margin-right:16rpx}.label{font-size:23rpx;color:#777;margin:20rpx 0 9rpx}input,.picker,textarea{box-sizing:border-box;width:100%;min-height:82rpx;border:1rpx solid #c9c5bd;background:#fdfcf8;padding:18rpx 20rpx;font-size:28rpx;border-radius:0}.placeholder{color:#999}.phone-row{display:grid;grid-template-columns:1fr 180rpx;gap:12rpx}.phone-row button,.outline{border:1rpx solid #222;background:#fff;border-radius:0;font-size:26rpx}.found{border-left:5rpx solid #1d4d3a;background:#f2f8f4;padding:18rpx;margin-top:18rpx;font-size:26rpx}.pet-list{display:grid;gap:10rpx;margin-top:14rpx}.pet{border:1rpx solid #d8d4cc;padding:18rpx;font-size:28rpx}.pet text{font-size:23rpx;color:#777;margin-left:12rpx}.outline{width:100%;margin-top:16rpx;height:74rpx}.new-pet{border-top:1rpx dashed #bbb;margin-top:22rpx;padding-top:8rpx}.pet-basics{display:grid;grid-template-columns:minmax(180rpx,.8fr) minmax(330rpx,1.35fr);gap:18rpx}.radio-row{display:grid;align-items:center;min-height:64rpx}.species-row{grid-template-columns:repeat(2,minmax(0,1fr))}.gender-row{grid-template-columns:repeat(3,minmax(0,1fr))}.radio-row label{display:flex;align-items:center;white-space:nowrap;font-size:26rpx;min-width:0}.radio-row radio{flex:none;transform:scale(.9);transform-origin:left center}.question label{margin-right:20rpx;font-size:26rpx}.question-tip{background:#fff8e8;border-left:5rpx solid #6b4423;padding:18rpx;font-size:23rpx;line-height:1.7}.question{padding:24rpx 4rpx;border-bottom:1rpx solid #ddd}.question.risk{background:#fff4f1;margin:0 -12rpx;padding:24rpx 16rpx;border-left:5rpx solid #7a2828}.question-label{font-size:27rpx;font-weight:600;line-height:1.55;margin-bottom:14rpx}.question textarea{margin-top:14rpx;min-height:120rpx;font-size:25rpx}.error{color:#7a2828;background:#fff0ed;border-left:5rpx solid #7a2828;padding:18rpx;margin-top:22rpx;font-size:25rpx}.submit{width:100%;height:92rpx;background:#1a1a1a;color:#fff;border-radius:0;margin-top:24rpx;font-family:serif;font-size:30rpx;font-weight:700}.foot{text-align:center;color:#888;font-size:22rpx;line-height:1.7;padding:20rpx 22rpx}
