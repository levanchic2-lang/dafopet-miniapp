.page{padding:32rpx;background:#f7f6f2;min-height:100vh;color:#1a1a1a}.head{padding:18rpx 4rpx 36rpx;border-bottom:1rpx solid #222;margin-bottom:28rpx}.kicker{font-size:20rpx;letter-spacing:5rpx;color:#888}.title{font-family:serif;font-size:52rpx;font-weight:700;margin-top:12rpx}.desc{font-size:25rpx;color:#777;margin-top:10rpx}.entry{width:100%;min-height:168rpx;background:#fff;border:1rpx solid #bbb;border-radius:0;margin:0 0 22rpx;padding:28rpx 30rpx;display:flex;align-items:center;justify-content:space-between;text-align:left}.entry.primary{background:#1a1a1a;color:#fff;border-color:#1a1a1a}.entry-title{font-family:serif;font-size:36rpx;font-weight:700}.entry-desc{font-size:24rpx;color:#777;margin-top:10rpx;line-height:1.5}.primary .entry-desc{color:#ccc}.entry>text{font-size:50rpx;font-weight:300}.notice{border-left:5rpx solid #6b4423;padding:20rpx 24rpx;background:#fffaf0;color:#66533e;font-size:24rpx;line-height:1.8;margin-top:32rpx}
.recent{background:#fff;border-left:6rpx solid #1d4d3a;padding:22rpx 24rpx;margin-bottom:24rpx}.recent-label{font-size:20rpx;letter-spacing:3rpx;color:#888}.recent-title{font-family:serif;font-size:31rpx;font-weight:700;margin-top:8rpx}.recent-date{font-size:23rpx;color:#777;margin-top:8rpx}.care{border-top:1rpx solid #ddd;margin-top:18rpx;padding-top:16rpx;font-size:24rpx;line-height:1.8;color:#4a4a4a}.care-title{font-weight:700;color:#1a1a1a;margin-bottom:5rpx}
.resume{margin:20rpx 0 0;width:100%;height:76rpx;line-height:74rpx;border:1rpx solid #1a1a1a;border-radius:0;background:#1a1a1a;color:#fff;font-size:27rpx;font-family:serif}.resume::after{border:0}
