<view class="home-page">
  <view class="home-head">
    <view class="home-kicker">DAFO ANIMAL HOSPITAL</view>
    <view class="home-title">大风动物医院</view>
    <view class="home-sub">线上服务中心</view>
  </view>

  <view class="notify-card {{notifyReady ? 'is-ready' : ''}}">
    <view class="notify-copy">
      <view class="notify-step">第一步</view>
      <view class="notify-title">{{notifyReady ? '通知提醒已开启' : '开启通知提醒'}}</view>
      <view class="notify-desc">用于接收TNR审核、预约及手术进度通知</view>
    </view>
    <button class="notify-action" bindtap="onEnableNotify" loading="{{notifyLoading}}">
      {{notifyReady ? '重新授权' : '立即开启'}}
    </button>
  </view>
  <view wx:if="{{notifyStatusText}}" class="notify-message">{{notifyStatusText}}</view>

  <view class="section core-section">
    <view class="section-label">流浪猫 TNR</view>
    <button class="primary-entry" bindtap="goTnrGuidePage">
      <view class="entry-order">01</view>
      <view class="entry-copy">
        <view class="entry-title">TNR 申请流程</view>
        <view class="entry-desc">第一次申请请先查看，准备齐全更顺利</view>
      </view>
      <view class="entry-arrow">›</view>
    </button>
    <button class="secondary-entry" bindtap="goApplyPage">
      <view class="entry-order dark">02</view>
      <view class="entry-copy">
        <view class="entry-title dark">申请流浪猫绝育（TNR）</view>
        <view class="entry-desc dark-muted">填写资料并提交医院审核</view>
      </view>
      <view class="entry-arrow dark">›</view>
    </button>
    <button class="secondary-entry" bindtap="goStatusPage">
      <view class="entry-order dark">03</view>
      <view class="entry-copy">
        <view class="entry-title dark">我的TNR申请 / 查看进度</view>
        <view class="entry-desc dark-muted">查看审核、预约及手术状态</view>
      </view>
      <view class="entry-arrow dark">›</view>
    </button>
  </view>

  <view class="section">
    <view class="section-label">医院服务</view>
    <view class="service-grid">
      <button class="service-entry" bindtap="goBindPage">
        <view class="service-index">04</view>
        <view class="service-title">绑定我的档案</view>
        <view class="service-desc">关联既有客户和宠物</view>
      </button>
      <button class="service-entry" bindtap="goAppointmentPage">
        <view class="service-index">05</view>
        <view class="service-title">预约服务</view>
        <view class="service-desc">门诊、手术与美容</view>
      </button>
      <button class="service-entry" bindtap="goAppointmentListPage">
        <view class="service-index">06</view>
        <view class="service-title">我的预约</view>
        <view class="service-desc">查看预约安排</view>
      </button>
      <button class="service-entry" bindtap="goImmunizationPage">
        <view class="service-index">07</view>
        <view class="service-title">电子免疫证</view>
        <view class="service-desc">接种记录与证书下载</view>
      </button>
    </view>
  </view>

  <view class="section">
    <view class="section-label">公益服务</view>
    <view class="list-group">
      <button class="list-entry" bindtap="goAdoptionPage">
        <view><text class="list-index">08</text><text class="list-title">待领养动物</text></view>
        <view class="list-arrow">›</view>
      </button>
      <button class="list-entry" bindtap="goShowcase">
        <view><text class="list-index">09</text><text class="list-title">TNR爱心展示</text></view>
        <view class="list-arrow">›</view>
      </button>
      <button class="list-entry" bindtap="goRabiesPage">
        <view>
          <view><text class="list-index">10</text><text class="list-title">狂犬疫苗免疫登记</text></view>
          <view class="list-note">仅限横岗店使用</view>
        </view>
        <view class="list-arrow">›</view>
      </button>
    </view>
  </view>

  <view class="section support-section">
    <view class="section-label">帮助支持</view>
    <view class="support-grid">
      <button class="support-entry" bindtap="goFeedbackPage">问题反馈</button>
      <button class="support-entry" open-type="contact">联系客服</button>
    </view>
  </view>

  <view class="home-foot">大风动物医院 · 始于 2018</view>
</view>
