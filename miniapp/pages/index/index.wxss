.home-page {
  min-height: 100vh;
  padding: 36rpx 28rpx 64rpx;
  box-sizing: border-box;
  background: #f7f7f5;
  color: #171717;
}

.home-head { padding: 12rpx 4rpx 32rpx; }
.home-kicker { font-size: 20rpx; letter-spacing: 5rpx; color: #8a8a85; }
.home-title { margin-top: 10rpx; font-size: 48rpx; line-height: 1.2; font-weight: 750; }
.home-sub { margin-top: 8rpx; font-size: 25rpx; color: #737373; }

.notify-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  background: #fff7ed;
  border-left: 6rpx solid #8a4f1d;
}
.notify-card.is-ready { background: #f0f7f3; border-left-color: #1d4d3a; }
.notify-copy { flex: 1; min-width: 0; }
.notify-step { font-size: 20rpx; color: #8a4f1d; letter-spacing: 2rpx; }
.is-ready .notify-step { color: #1d4d3a; }
.notify-title { margin-top: 5rpx; font-size: 29rpx; font-weight: 700; }
.notify-desc { margin-top: 6rpx; font-size: 22rpx; line-height: 1.45; color: #737373; }
.notify-action {
  flex: 0 0 auto;
  margin: 0;
  padding: 0 22rpx;
  min-height: 72rpx;
  line-height: 72rpx;
  border-radius: 4rpx;
  background: #171717;
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
}
.notify-action::after { border: 0; }
.notify-message { padding: 12rpx 6rpx 0; font-size: 22rpx; color: #525252; line-height: 1.5; }

.section { margin-top: 42rpx; }
.core-section { margin-top: 30rpx; }
.section-label { margin-bottom: 16rpx; font-size: 23rpx; color: #737373; letter-spacing: 3rpx; }

.primary-entry,
.secondary-entry {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 132rpx;
  margin: 0;
  padding: 24rpx;
  border-radius: 4rpx;
  text-align: left;
  box-sizing: border-box;
}
.primary-entry { background: #171717; color: #fff; }
.secondary-entry { margin-top: 12rpx; background: #fff; color: #171717; border: 1rpx solid #d4d4d4; }
.primary-entry::after, .secondary-entry::after { border: 0; }
.entry-order { width: 62rpx; font-size: 21rpx; color: #a3a3a3; letter-spacing: 2rpx; }
.entry-order.dark { color: #8a8a8a; }
.entry-copy { flex: 1; min-width: 0; }
.entry-title { color: #fff; font-size: 30rpx; font-weight: 700; line-height: 1.35; }
.entry-title.dark { color: #171717; }
.entry-desc { margin-top: 7rpx; color: #bdbdbd; font-size: 23rpx; line-height: 1.4; }
.entry-desc.dark-muted { color: #737373; }
.entry-arrow { color: #fff; font-size: 48rpx; font-weight: 300; }
.entry-arrow.dark { color: #737373; }

.service-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; }
.service-entry {
  min-height: 176rpx;
  margin: 0;
  padding: 22rpx;
  border: 1rpx solid #d8d8d4;
  border-radius: 4rpx;
  background: #fff;
  text-align: left;
  box-sizing: border-box;
}
.service-entry::after { border: 0; }
.service-index { color: #a3a3a3; font-size: 20rpx; letter-spacing: 2rpx; }
.service-title { margin-top: 16rpx; color: #171717; font-size: 27rpx; font-weight: 700; line-height: 1.3; }
.service-desc { margin-top: 8rpx; color: #737373; font-size: 21rpx; line-height: 1.4; }

.list-group { border-top: 1rpx solid #d4d4d0; }
.list-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-height: 96rpx;
  margin: 0;
  padding: 20rpx 10rpx;
  border-radius: 0;
  border-bottom: 1rpx solid #d4d4d0;
  background: transparent;
  text-align: left;
  box-sizing: border-box;
}
.list-entry::after { border: 0; }
.list-index { display: inline-block; width: 62rpx; color: #a3a3a3; font-size: 20rpx; letter-spacing: 2rpx; }
.list-title { color: #171717; font-size: 27rpx; font-weight: 650; }
.list-note { margin: 5rpx 0 0 62rpx; color: #8a8a8a; font-size: 21rpx; }
.list-arrow { color: #8a8a8a; font-size: 42rpx; }

.support-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; }
.support-entry {
  min-height: 88rpx;
  margin: 0;
  border-radius: 4rpx;
  border: 1rpx solid #d4d4d0;
  background: #fff;
  color: #262626;
  font-size: 25rpx;
}
.support-entry::after { border: 0; }
.home-foot { margin-top: 60rpx; text-align: center; color: #a3a3a3; font-size: 20rpx; letter-spacing: 2rpx; }

@media (max-width: 340px) {
  .service-grid { grid-template-columns: 1fr; }
  .notify-card { align-items: flex-start; }
  .notify-action { padding: 0 14rpx; }
}
